        const t = I18N[userLang] || I18N.en;

        document.getElementById('t-subtitle').innerText = t.subtitle;
        document.getElementById('t-send-title').innerText = t.send_title;
        document.getElementById('t-drop-title').innerText = t.drop_title;
        document.getElementById('t-drop-sub').innerText = t.drop_sub;
        const getTitle = document.getElementById('t-get-title');
        if (getTitle) getTitle.innerText = t.get_title;
        document.querySelectorAll('.t-dl-btn').forEach(el => el.innerText = t.download);

        const fileInput = document.getElementById('fileInput');
        const progressContainer = document.getElementById('progressContainer');
        const progressBar = document.getElementById('progressBar');
        const progressStatus = document.getElementById('progressStatus');

        fileInput.addEventListener('change', () => {{
            if (fileInput.files.length === 0) return;
            uploadFiles(fileInput.files);
        }});

        function uploadFiles(files) {{
            const formData = new FormData();
            for (let i = 0; i < files.length; i++) formData.append('files', files[i]);

            progressContainer.style.display = 'block';
            progressBar.style.width = '0%';
            progressBar.style.background = '';   // låt CSS-gradienten styra
            progressStatus.innerText = t.starting;

            const xhr = new XMLHttpRequest();
            xhr.open('POST', 'upload', true);       // relativ: behåller token-prefixet

            xhr.upload.onprogress = (e) => {{
                if (e.lengthComputable) {{
                    const percent = Math.round((e.loaded / e.total) * 100);
                    progressBar.style.width = percent + '%';
                    const mb = (e.loaded / (1024*1024)).toFixed(1);
                    const totalMb = (e.total / (1024*1024)).toFixed(1);
                    progressStatus.innerText = `${{t.uploading}} ${{percent}}% (${{mb}} / ${{totalMb}} MB)`;
                }}
            }};

            xhr.onload = () => {{
                if (xhr.status === 200) {{
                    progressBar.style.background = 'var(--success)';
                    progressStatus.innerText = t.done;
                    setTimeout(() => {{
                        progressContainer.style.display = 'none';
                        progressBar.style.background = 'var(--accent)';
                    }}, 4000);
                }} else if (xhr.status === 413) {{
                    progressStatus.innerText = t.too_big;
                }} else {{
                    progressStatus.innerText = t.error;
                }}
            }};

            xhr.onerror = () => {{ progressStatus.innerText = t.conn_error; }};
            xhr.send(formData);
        }}
    </script>
</body>
</html>"""


class SlingHandler(BaseHTTPRequestHandler):
    server_version = "Sling/" + VERSION
    protocol_version = "HTTP/1.1"

    def log_message(self, fmt, *args):
        pass

    def _resolve(self):
        """Sökvägen efter token-prefixet, annars None (→ 403)."""
        path = urllib.parse.urlparse(self.path).path
        prefix = "/t/%s" % current_token()
        if current_token() and path.startswith(prefix):
            LAST_ACTIVITY["t"] = time.monotonic()
            return path[len(prefix):] or "/"
        return None

    def _send(self, code, body=b"", ctype="text/plain; charset=utf-8", extra=None):
        self.send_response(code)
        if body:
            self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        for key, value in (extra or {}).items():
            self.send_header(key, value)
        self.end_headers()
        if body:
            self.wfile.write(body)

    def _no_token(self):
        self._send(403, ("Sling is running. Use the link or QR code from the bar panel.\n"
                         "Sling körs. Använd länken eller QR-koden i panelen.\n").encode())

    def do_HEAD(self):
        rest = self._resolve()
        if rest is None:
            self._no_token()
        else:
            self._send(200)

    def do_GET(self):
        rest = self._resolve()
        if rest is None:
            self._no_token()
            return

        if rest in ("/", "/index.html"):
            send_files = list_files(SEND_DIR)
            rows = "".join(
                '<div class="file-item"><div class="file-info"><span class="file-name">📄 %s</span>'
                '<span class="file-size">%s</span></div>'
                '<a href="download/%s" class="dl-btn t-dl-btn" download>Download</a></div>'
                % (html.escape(f["name"]), f["size"], urllib.parse.quote(f["name"]))
                for f in send_files)
            page = PAGE.format(download_display="display: block;" if send_files else "display: none;",
                               file_rows=rows).encode()
            self._send(200, page, "text/html; charset=utf-8", {"Cache-Control": "no-store"})

        elif rest == "/status":
            self._send(200, json.dumps(status_dict(True)).encode(), "application/json")

        elif rest.startswith("/download/"):
            name = os.path.basename(urllib.parse.unquote(rest[len("/download/"):]))
            filepath = os.path.join(SEND_DIR, name)
            if name and os.path.isfile(filepath):
                size = os.path.getsize(filepath)
                self.send_response(200)
                self.send_header("Content-Type", "application/octet-stream")
                # RFC 5987-formen klarar icke-ASCII och kan inte injicera rubriker.
                self.send_header("Content-Disposition", "attachment; filename*=UTF-8''" + urllib.parse.quote(name))
                self.send_header("Content-Length", str(size))
                self.end_headers()
                start_transfer("down", name, size)
                try:
                    with open(filepath, "rb") as fh:
                        while chunk := fh.read(65536):
                            self.wfile.write(chunk)
                            bump_transfer(len(chunk))
                except (BrokenPipeError, ConnectionResetError):
                    log("avbruten nedladdning: %s" % name)
                finally:
                    end_transfer()
            else:
                self._send(404)

        else:
            self._send(404)

    def do_POST(self):
        rest = self._resolve()
        if rest is None:
            self._no_token()
            return
        if rest != "/upload":
            self._send(404)
            return

        ctype = self.headers.get("Content-Type", "")
        try:
            length = int(self.headers.get("Content-Length", 0))
        except ValueError:
            length = 0
        if not ctype.startswith("multipart/form-data") or length == 0:
            self._send(400)
            return
        if length > MAX_UPLOAD:
            log("avvisade uppladdning på %d byte (tak %d)" % (length, MAX_UPLOAD))
            # Läs och släng kroppen (upp till 8 MB) INNAN svaret skickas: annars
            # får klienten en bruten anslutning mitt i sin egen uppladdning i
            # stället för beskedet. Sedan stängs anslutningen — resten av kroppen
            # skulle annars tolkas som nästa förfrågan.
            self.close_connection = True
            drain = min(length, 8 * 1024 * 1024)
            while drain > 0:
                chunk = self.rfile.read(min(65536, drain))
                if not chunk:
                    break
                drain -= len(chunk)
            self._send(413, json.dumps({"ok": False, "error": "too large"}).encode(), "application/json")
            return

        def track(nbytes, name=None):
            if name:
                ACTIVE["name"] = name
            bump_transfer(nbytes)

        start_transfer("up", "", length)
        try:
            saved = stream_multipart(self.rfile, ctype, length, RECEIVED_DIR, on_progress=track)
        except OSError as exc:
            log("uppladdning misslyckades: %s" % exc)
            self._send(500, json.dumps({"ok": False, "error": str(exc)}).encode(), "application/json")
            return
        finally:
            end_transfer()

        if saved:
            key = "received_single" if len(saved) == 1 else "received_multi"
            summary = NOTIF_STRINGS[get_system_lang()][key].format(count=len(saved))
            # Bara antalet i notisen: filnamnen är privat metadata och låg förut i argv,
            # läsbar för varje lokal användare som ser processlistan.
            subprocess.run(["notify-send", summary, "--icon=folder-download", "-a", "Sling"], check=False)
            log("tog emot %d fil(er): %s" % (len(saved), ", ".join(saved[:3])))

        self._send(200, json.dumps({"ok": True, "saved": saved}).encode(), "application/json")


class SlingServer(ThreadingHTTPServer):
    daemon_threads = True

    def server_bind(self):
        """Hoppar över BaseHTTPServer.server_bind, som gör en omvänd DNS-lookup
        (socket.getfqdn) innan socketen börjar lyssna. Mätt: 5,01 s på den här
        maskinen — och eftersom PID-filen skrevs först visade panelen "running"
        medan ingenting svarade."""
        import socketserver
        socketserver.TCPServer.server_bind(self)
        self.server_name = "sling"
        self.server_port = self.server_address[1]


# ------------------------------------------------------------------------------
# Status — en källa för CLI och HTTP
# ------------------------------------------------------------------------------
def status_dict(running=None):
    token = current_token() or read_token()
    ip = get_local_ip()
    if running is None:
        running = port_open()
    if running:
        generate_qr(server_url(token, ip))
    data = {
        "ok": True,
        "version": VERSION,
        "running": bool(running),
        "ip": ip,
        "port": PORT,
        "url": server_url(token, ip),
        "mdns_url": "http://%s.local:%d/t/%s/" % (MDNS_NAME, PORT, token),
        "idle_timeout": IDLE_TIMEOUT,
        "max_upload": MAX_UPLOAD,
        "qr_path": QR_PATH,
        "qr_ok": os.path.exists(QR_PATH),
        "received_dir": RECEIVED_DIR,
        "send_dir": SEND_DIR,
        "recent_files": list_files(RECEIVED_DIR, 5),
        "send_files": list_files(SEND_DIR),
        "active": active_dict(),
    }
    # En pågående överföring finns bara i serverprocessens minne. CLI:t — och
    # därmed panelens poll — måste hämta den från serverns eget /status; annars
    # stod docken på "redo" medan en fil rullade (mätt).
    if running and not IS_SERVER:
        live = server_status(token)
        if live and "active" in live:
            data["active"] = live["active"]
    return data


def server_status(token):
    """Serverns egen /status, eller None om den inte svarar."""
    try:
        with urllib.request.urlopen("http://127.0.0.1:%d/t/%s/status" % (PORT, token), timeout=2) as r:
            return json.loads(r.read())
    except Exception:
        return None


# ------------------------------------------------------------------------------
# Kommandon
# ------------------------------------------------------------------------------
def cmd_server():
    global _TOKEN, IS_SERVER
    IS_SERVER = True
    _TOKEN = secrets.token_urlsafe(9)
    with open(TOKEN_FILE, "w") as fh:
        fh.write(_TOKEN)
    os.chmod(TOKEN_FILE, 0o600)
    url = server_url(_TOKEN)
    with open(PID_FILE, "w") as fh:
        fh.write(str(os.getpid()))

    mdns = start_mdns()
    server = SlingServer(("0.0.0.0", PORT), SlingHandler)
    threading.Thread(target=server.serve_forever, daemon=True).start()
    qr_ok = generate_qr(url)
    log("lyssnar på 0.0.0.0:%d, mDNS=%s, qr_ok=%s" % (PORT, bool(mdns), qr_ok))

    def bye(*_):
        raise SystemExit(0)

    signal.signal(signal.SIGTERM, bye)
    signal.signal(signal.SIGINT, bye)
    try:
        while time.monotonic() - LAST_ACTIVITY["t"] <= IDLE_TIMEOUT:
            time.sleep(2)
        log("ingen trafik på %ds — avväpnar" % IDLE_TIMEOUT)
    except (KeyboardInterrupt, SystemExit):
        pass
    finally:
        server.shutdown()
        server.server_close()
        if mdns:
            mdns.terminate()
        for path in (PID_FILE, TOKEN_FILE):
            try:
                os.remove(path)
            except OSError:
                pass


def cmd_start():
    if port_open():
        print("Sling is already running.")
        return 0
    with open(LOG_PATH, "a") as logfh:
        subprocess.Popen([sys.executable, os.path.abspath(__file__), "server"],
                         stdout=logfh, stderr=logfh, start_new_session=True)
    for _ in range(50):                     # upp till ~5 s
        if port_open():
            print("Sling started: %s" % server_url(read_token()))
            return 0
        time.sleep(0.1)
    print("Sling did not come up — se %s" % LOG_PATH, file=sys.stderr)
    return 1


def cmd_stop():
    pid = None
    try:
        with open(PID_FILE) as fh:
            pid = int(fh.read().strip())
    except (OSError, ValueError):
        pass
    if pid:
        try:
            os.kill(pid, signal.SIGTERM)
            for _ in range(30):
                if not port_open():
                    break
                time.sleep(0.1)
        except ProcessLookupError:
            pass
    if port_open():
        subprocess.run(["pkill", "-f", "omarchy-sling server"], check=False)
    print("Sling stopped.")
    return 0


def cmd_status():
    print(json.dumps(status_dict()))
    return 0


def cmd_open():
    subprocess.run(["xdg-open", RECEIVED_DIR], check=False)
    return 0


def cmd_copy(which=None):
    """Lägger serverns URL i urklipp — via stdin, aldrig argv (token!).

    Mätt 2026-10-08: Quickshells `Process` med `stdinEnabled` skickar texten men
    stänger inte stdin, och `wl-copy` läser till EOF — den kopierade ingenting.
    Pythons `input=` skickar och stänger, så kopieringen hamnar här i stället.
    """
    token = current_token() or read_token()
    if not token:
        print("ingen token — starta servern först", file=sys.stderr)
        return 1
    url = server_url(token) if which != "mdns" else "http://%s.local:%d/t/%s/" % (MDNS_NAME, PORT, token)
    if not shutil.which("wl-copy"):
        print("wl-copy saknas", file=sys.stderr)
        return 1
    subprocess.run(["wl-copy"], input=url.encode(), check=False)
    print(url)
    return 0


def cmd_send(paths):
    """Lägger filer i Send/. Symlänk i första hand — en 2 GB-video ska inte
    behöva finnas i två kopior för att kunna hämtas."""
    count = 0
    for raw in paths:
        src = os.path.abspath(os.path.expanduser(raw))
        if not os.path.isfile(src):
            print("hoppar över %s (ingen fil)" % src, file=sys.stderr)
            continue
        dest = unique_path(SEND_DIR, os.path.basename(src))
        try:
            os.symlink(src, dest)
        except OSError:
            shutil.copy2(src, dest)
        print(dest)
        count += 1
    return 0 if count else 1


def cmd_send_pick():
    if not shutil.which("zenity"):
        print("zenity saknas — öppnar Send-mappen i stället", file=sys.stderr)
        subprocess.run(["xdg-open", SEND_DIR], check=False)
        return 1
    r = subprocess.run(["zenity", "--file-selection", "--multiple", "--separator=\n",
                        "--title=Sling: skicka till telefonen"],
                       capture_output=True, text=True)
    paths = [line for line in r.stdout.splitlines() if line.strip()]
    return cmd_send(paths) if paths else 1


# ------------------------------------------------------------------------------
# Egenkontroll: parsern, token-grinden, taket
# ------------------------------------------------------------------------------
def cmd_selftest():
    """Kör en server på egen port i en städad miljö och verifierar att filer kommer
    fram byte-identiska, att saknad/fel token nekas och att storlekstaket håller."""
    import tempfile
    import urllib.error
    import urllib.request

    tmp = tempfile.mkdtemp(prefix="sling-selftest-")
    port = int(os.environ.get("SLING_SELFTEST_PORT", "5381"))
    env = dict(os.environ,
               SLING_PORT=str(port),
               SLING_BASE_DIR=tmp,
               SLING_IDLE_TIMEOUT="60",
               SLING_MAX_UPLOAD="2097152",            # 2 MB i provet
               XDG_RUNTIME_DIR=tmp,
               SLING_MDNS_NAME="sling-test")
    proc = subprocess.Popen([sys.executable, os.path.abspath(__file__), "server"],
                            env=env, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    failures = []
    counted = {"n": 0}

    def check(name, cond, detail=""):
        counted["n"] += 1
        print("  %-50s %s%s" % (name, "OK" if cond else "MISSLYCKADES", ("  " + detail) if detail else ""))
        if not cond:
            failures.append(name)

    def multipart(files):
        b = "----slingtest"
        out = b""
        for name, data in files:
            out += ("--%s\r\nContent-Disposition: form-data; name=\"files\"; filename=\"%s\"\r\n"
                    "Content-Type: application/octet-stream\r\n\r\n" % (b, name)).encode() + data + b"\r\n"
        return out + ("--%s--\r\n" % b).encode(), "multipart/form-data; boundary=" + b

    def post(files, token):
        body, ctype = multipart(files)
        req = urllib.request.Request("http://127.0.0.1:%d/t/%s/upload" % (port, token), data=body,
                                     headers={"Content-Type": ctype}, method="POST")
        try:
            with urllib.request.urlopen(req, timeout=30) as r:
                return r.status, json.loads(r.read())
        except urllib.error.HTTPError as e:
            return e.code, {}

    try:
        for _ in range(80):
            try:
                urllib.request.urlopen("http://127.0.0.1:%d/" % port, timeout=1)
                break
            except urllib.error.HTTPError:
                break
            except Exception:
                time.sleep(0.1)

        with open(os.path.join(tmp, "sling", "token")) as fh:
            token = fh.read().strip()

        payloads = [
            ("tom.bin", b""),
            ("liten.bin", bytes(range(256)) * 400),                       # 100 kB
            ("stor.bin", os.urandom(900_000)),                            # 900 kB, många buffertvarv
        ]
        code, reply = post(payloads, token)
        check("uppladdning svarar 200", code == 200, "fick %s" % code)
        check("tre filer rapporterade", len(reply.get("saved", [])) == 3, "fick %s" % reply.get("saved"))
        for name, data in payloads:
            path = os.path.join(tmp, "Received", name)
            ok = os.path.isfile(path) and open(path, "rb").read() == data
            check("byte-identisk: %s (%d B)" % (name, len(data)), ok)
            if not ok:
                break

        # En kropp som innehåller själva gränssträngen går inte att representera i
        # multipart (avsändaren ska välja en gräns som inte förekommer i innehållet).
        # Det som måste hålla är att parsern inte tappar bort de följande delarna.
        fake = b"\r\n----slingtest\r\n" * 5000
        real = os.urandom(200_000)
        code, reply = post([("gräns.bin", fake), ("efter.bin", real)], token)
        check("del efter gräns-kropp kommer fram", os.path.isfile(os.path.join(tmp, "Received", "efter.bin")),
              "fick %s" % reply.get("saved"))
        efter = os.path.join(tmp, "Received", "efter.bin")
        check("  ... och är byte-identisk", os.path.isfile(efter) and open(efter, "rb").read() == real)
        gran = os.path.join(tmp, "Received", "gräns.bin")
        check("  gräns-kroppen är en trunkerad prefix",
              os.path.isfile(gran) and fake.startswith(open(gran, "rb").read()))

        code, reply = post([("liten.bin", b"x")], token)
        check("dubblettnamn får _1", "liten_1.bin" in reply.get("saved", []), "fick %s" % reply.get("saved"))

        code, _ = post([("tak.bin", b"y" * (3 * 1024 * 1024))], token)
        check("för stor uppladdning nekas (413)", code == 413, "fick %s" % code)
        check("ingen dellfil av den nekade finns", not os.path.exists(os.path.join(tmp, "Received", "tak.bin")))

        code, _ = post([("x.bin", b"z")], "fel-token")
        check("fel token nekas (403)", code == 403, "fick %s" % code)
        try:
            urllib.request.urlopen("http://127.0.0.1:%d/" % port, timeout=5)
            check("utan token nekas (403)", False, "släpptes igenom")
        except urllib.error.HTTPError as e:
            check("utan token nekas (403)", e.code == 403, "fick %s" % e.code)

        with urllib.request.urlopen("http://127.0.0.1:%d/t/%s/" % (port, token), timeout=5) as r:
            page = r.read().decode()
        check("mobilsidan renderas (200)", "Sling" in page)

        with urllib.request.urlopen("http://127.0.0.1:%d/t/%s/status" % (port, token), timeout=5) as r:
            st = json.loads(r.read())
        check("status har running/url/qr_ok", all(k in st for k in ("running", "url", "qr_ok")))
        check("status-url bär token", token in st["url"], st["url"])
        check("QR-koden skapas (qrencode via stdin)", st["qr_ok"] is True)
        check("status har active-nyckeln (None när inget pågår)", st.get("active") is None, str(st.get("active")))

        # Token får aldrig hamna i en process kommandorad (argv) — en annan lokal
        # användare kan läsa den ur processlistan. Provet fångar arg-versionen av
        # generate_qr genom att spionera på subprocess.run, med QR- och URL-filerna
        # omdirigerade till provets egen katalog så inget rörs i skarp drift.
        saved_paths = (globals()["QR_PATH"], globals()["URL_FILE"])
        globals()["QR_PATH"] = os.path.join(tmp, "qr-test.png")
        globals()["URL_FILE"] = os.path.join(tmp, "url-test")
        seen = {"cmd": [], "input": None}
        real_run = subprocess.run

        def spy(cmd, **kw):
            seen["cmd"] = list(cmd)
            seen["input"] = kw.get("input")
            return real_run(cmd, **kw)

        try:
            subprocess.run = spy
            try:
                qr_ok = generate_qr("http://10.0.0.9:5380/t/HEMLIG-TOKEN/")
            finally:
                subprocess.run = real_run
        finally:
            globals()["QR_PATH"], globals()["URL_FILE"] = saved_paths
        joined = " ".join(seen["cmd"])
        check("QR skapas utan token i argv", qr_ok and "HEMLIG-TOKEN" not in joined,
              "argv: " + joined)
        check("  ... URL:en går på stdin", seen["input"] == b"http://10.0.0.9:5380/t/HEMLIG-TOKEN/",
              repr(seen["input"]))

        # Samma skydd för kopieringen: wl-copy ska få URL:en på stdin, aldrig i argv.
        saved_token_file = globals()["TOKEN_FILE"]
        globals()["TOKEN_FILE"] = os.path.join(tmp, "sling", "token")
        globals()["_TOKEN"] = ""
        seen_copy = {"cmd": [], "input": None}
        real_copy_run = subprocess.run

        class FakeDone:
            returncode = 0

        def spy_copy(cmd, **kw):
            seen_copy["cmd"] = list(cmd)
            seen_copy["input"] = kw.get("input")
            return FakeDone()

        try:
            subprocess.run = spy_copy
            try:
                rc = cmd_copy()
            finally:
                subprocess.run = real_copy_run
        finally:
            globals()["TOKEN_FILE"] = saved_token_file
            globals()["_TOKEN"] = ""
        joined_copy = " ".join(seen_copy["cmd"])
        check("kopieringen går via stdin, inte argv",
              rc == 0 and joined_copy == "wl-copy" and token not in joined_copy, "argv: " + joined_copy)
        check("  ... och bär hela token-URL:en",
              (seen_copy["input"] or b"").decode().endswith("/t/%s/" % token),
              "%d byte på stdin" % len(seen_copy["input"] or b""))

        # Förloppsindikatorn mäts mitt i en överföring. Kroppen skickas i bitar med
        # paus, så servern står kvar i läsningen och 'active' går att se — till
        # skillnad från att hoppas att en nedladdning inte hinner klart i bufferten.
        class SlowBody:
            def __init__(self, data, chunk=65536, delay=0.08):
                self.data, self.pos, self.chunk, self.delay = data, 0, chunk, delay

            def read(self, n=None):
                time.sleep(self.delay)
                piece = self.data[self.pos:self.pos + self.chunk]
                self.pos += len(piece)
                return piece

        # Under provets eget tak (2 MB) — annars svarar servern 413 och provet mäter inget.
        payload = os.urandom(1_500_000)
        body, ctype = multipart([("stor3.bin", payload)])
        req = urllib.request.Request("http://127.0.0.1:%d/t/%s/upload" % (port, token), data=SlowBody(body),
                                     headers={"Content-Type": ctype, "Content-Length": str(len(body))}, method="POST")

        mid = {}
        done = threading.Event()

        def slow_post():
            try:
                with urllib.request.urlopen(req, timeout=60) as r:
                    mid["status"] = r.status
                    mid["saved"] = json.loads(r.read()).get("saved")
            except Exception as exc:                        # noqa: BLE001 — provet rapporterar själv
                mid["fel"] = repr(exc)
            done.set()

        threading.Thread(target=slow_post, daemon=True).start()
        seen = None
        deadline = time.time() + 20
        while time.time() < deadline and not done.is_set():
            with urllib.request.urlopen("http://127.0.0.1:%d/t/%s/status" % (port, token), timeout=5) as r:
                a = json.loads(r.read()).get("active")
            if a and a.get("dir") == "up" and a.get("done", 0) > 0:
                seen = a
                break
            time.sleep(0.1)
        check("pågående uppladdning syns i status", seen is not None,
              ("%s %d%% %s/%s" % (seen["name"], seen["pct"], seen["human_done"], seen["human_total"])) if seen else "sågs aldrig")
        check("  ... med filnamn, total och progress", bool(seen) and seen["name"] == "stor3.bin"
              and seen["total"] == len(body) and 0 < seen["pct"] < 100, str(seen and seen.get("pct")))
        check("  ... och en fart i byte/s", bool(seen) and seen["speed"] > 0, str(seen and round(seen.get("speed", 0))))

        # Panelens egen väg: `omarchy-sling status` (CLI) måste visa samma pågående
        # överföring — den finns bara i serverprocessens minne och läses ur /status.
        cli = subprocess.run([sys.executable, os.path.abspath(__file__), "status"],
                             env=env, capture_output=True, text=True, timeout=20)
        try:
            cli_active = json.loads(cli.stdout).get("active")
        except ValueError:
            cli_active = None
        check("CLI-status visar samma pågående överföring", bool(cli_active) and cli_active.get("name") == "stor3.bin",
              (cli_active and "%s %d%%" % (cli_active["name"], cli_active["pct"])) or ("utdata: " + cli.stdout[:60]))
        done.wait(timeout=60)
        check("uppladdningen blev klar (200)", mid.get("status") == 200, str(mid.get("fel") or mid.get("status")))
        stor3 = os.path.join(tmp, "Received", "stor3.bin")
        check("  ... och filen är byte-identisk",
              os.path.isfile(stor3) and open(stor3, "rb").read() == payload)
        with urllib.request.urlopen("http://127.0.0.1:%d/t/%s/status" % (port, token), timeout=5) as r:
            after = json.loads(r.read()).get("active")
        check("active är tom igen efteråt", after is None, str(after))
    finally:
        proc.terminate()
        try:
            proc.wait(timeout=10)
        except subprocess.TimeoutExpired:
            proc.kill()
        shutil.rmtree(tmp, ignore_errors=True)

    print("\n%d kontroller, %d misslyckade" % (counted["n"], len(failures)))
    if failures:
        print("MISSLYCKADE: " + ", ".join(failures))
        return 1
    print("Sling selftest: OK")
    return 0


def main():
    action = sys.argv[1] if len(sys.argv) > 1 else "status"
    if action == "server":
        cmd_server()
    elif action == "start":
        sys.exit(cmd_start())
    elif action == "stop":
        sys.exit(cmd_stop())
    elif action == "status":
        sys.exit(cmd_status())
    elif action == "open":
        sys.exit(cmd_open())
    elif action == "send":
        sys.exit(cmd_send(sys.argv[2:]))
    elif action == "copy":
        sys.exit(cmd_copy(sys.argv[2] if len(sys.argv) > 2 else None))
    elif action == "send-pick":
        sys.exit(cmd_send_pick())
    elif action == "selftest":
        sys.exit(cmd_selftest())
    else:
        print("Usage: omarchy-sling [server | start | stop | status | open | send <fil...> | send-pick | copy [mdns] | selftest]")
        sys.exit(2)


if __name__ == "__main__":
    main()

def get_system_lang():
    lang_env = os.environ.get("LANG", "en_US.UTF-8").split(".")[0].split("_")[0].lower()
    return lang_env if lang_env in NOTIF_STRINGS else "en"


def log(msg):
    try:
        fd = os.open(LOG_PATH, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
        with os.fdopen(fd, "a") as fh:
            fh.write("%s  %s\n" % (time.strftime("%Y-%m-%d %H:%M:%S"), msg))
    except OSError:
        pass


# ------------------------------------------------------------------------------
# Nätverk och filer
# ------------------------------------------------------------------------------
def get_local_ip():
    """IP:t telefonen ska använda.

    UDP-knepet ger rätt interface utan att skicka ett paket. Saknas default-route
    (isolerat nät, hotspot utan gateway) faller vi tillbaka på första globala
    IPv4-adressen — gamla koden gav då 127.0.0.1, vilket pekar på telefonen själv
    och gör QR-koden verkningslös.
    """
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.connect(("1.1.1.1", 80))
        ip = s.getsockname()[0]
        s.close()
        if ip and not ip.startswith("127."):
            return ip
    except OSError:
        pass
    try:
        out = subprocess.run(["ip", "-4", "-o", "addr", "show", "scope", "global"],
                             capture_output=True, text=True, timeout=5).stdout
        m = re.search(r"inet (\d+\.\d+\.\d+\.\d+)", out)
        if m:
            return m.group(1)
    except Exception:
        pass
    return "127.0.0.1"


def port_open(host="127.0.0.1", port=None):
    s = socket.socket()
    s.settimeout(0.3)
    try:
        return s.connect_ex((host, port or PORT)) == 0
    finally:
        s.close()


def server_url(token, host=None):
    return "http://%s:%d/t/%s/" % (host or get_local_ip(), PORT, token)


def read_token():
    try:
        with open(TOKEN_FILE) as fh:
            return fh.read().strip()
    except OSError:
        return ""


def current_token():
    """Token för den här processen. Cachas: skulle filen försvinna mitt i körningen
    ska servern inte plötsligt släppa igenom vilken sökväg som helst."""
    global _TOKEN
    if not _TOKEN:
        _TOKEN = read_token()
    return _TOKEN


def human_size(size):
    """GB-nivån behövs: en 2 GB-video ska inte stå som '2048.0 MB' i panelen."""
    if size >= 1024 ** 3:
        return "%.2f GB" % (size / 1024 ** 3)
    if size >= 1024 ** 2:
        return "%.1f MB" % (size / 1024 ** 2)
    return "%.1f KB" % (size / 1024)


def unique_path(directory, filename):
    """Ledigt namn i katalogen. Används för kön (länkar), inte för uppladdningar:
    den kontrollerar och öppnar i två steg, se create_unique."""
    dest = os.path.join(directory, filename)
    base, ext = os.path.splitext(filename)
    counter = 1
    while os.path.exists(dest):
        dest = os.path.join(directory, "%s_%d%s" % (base, counter, ext))
        counter += 1
    return dest


def create_unique(directory, filename):
    """Skapar filen och tar namnet i SAMMA syscall. Ger (namn, filhandtag).

    unique_path frågade os.path.exists och öppnade sedan, så två samtidiga
    uppladdningar med samma namn valde samma sökväg och skrev över varandra —
    vilken fil som helst av dem kunde försvinna, medan båda svaren sa "saved".
    Mätt: 12 samtidiga `samma.jpg` gav 7-10 filer på disk men 12 svar. O_EXCL gör
    namnvalet och skapandet atomiskt: den som förlorar kapplöpningen får nästa
    lediga namn i stället.
    """
    base, ext = os.path.splitext(filename)
    counter = 0
    while True:
        name = filename if counter == 0 else "%s_%d%s" % (base, counter, ext)
        try:
            # 0600 från skapandet, som tokenfilen och urklippet: filen ska inte bli
            # läsbar för andra bara för att umask är 022 (mätt: en mottagen fil blev 0644).
            fd = os.open(os.path.join(directory, name), os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        except FileExistsError:
            counter += 1
            continue
        return name, os.fdopen(fd, "wb")


def list_files(directory, limit=None):
    """Filerna i katalogen, nyaste först. En fil som försvinner mitt i listningen
    hoppas över i stället för att kasta: panelen pollar /status var 1,5 s medan
    Alex rensar Received, och en förfrågan som dör utan svar syns ingenstans
    (mätt: 3092 av 5634 /status-anrop försvann utan svar i en körning med en fil
    som byttes ut hela tiden)."""
    if not os.path.isdir(directory):
        return []
    filer = []
    for f in os.listdir(directory):
        path = os.path.join(directory, f)
        try:
            if os.path.isfile(path):
                filer.append((f, os.path.getmtime(path), os.path.getsize(path)))
        except OSError:
            continue
    filer.sort(key=lambda rad: rad[1], reverse=True)
    if limit:
        filer = filer[:limit]
    return [{"name": f, "size": human_size(size)} for f, _, size in filer]


def write_private(path, data):
    """Skriver en fil med 0600 i en NY inode, atomiskt.

    Tre saker måste hålla samtidigt, och de är samma fynd i tre steg (HANCORE,
    ärende 10821):

    * **Mode vid skapandet.** open() ger 0666 & ~umask (0644 med umask 022), och den
      som hinner öppna filen behåller åtkomsten efter en efterföljande chmod.
    * **Ny inode varje gång.** Att skriva om en befintlig fil (O_TRUNC) låter en
      process som öppnade den under det gamla läsbara fönstret läsa allt som skrivs
      dit i framtiden — hur fina mode än är efteråt. Därför skrivs varje urklipp,
      token och URL till en helt ny fil.
    * **Atomiskt byte.** Skrivningen sker i samma katalog och byter namn över den
      gamla, så en läsare ser antingen den förra eller den nya filen, aldrig en halv.

    tempfile.mkstemp skapar redan med 0600 och ett namn ingen annan kan gissa.
    """
    mapp = os.path.dirname(path) or "."
    fd, tmp = tempfile.mkstemp(dir=mapp, prefix="." + os.path.basename(path) + ".")
    try:
        with os.fdopen(fd, "wb") as fh:
            fh.write(data.encode() if isinstance(data, str) else data)
        os.chmod(tmp, 0o600)
        os.replace(tmp, path)               # ny inode tar över namnet; gamla läsare tappar
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def kill_source(proc, klar):
    """Dödar klippkällan OCH dess barn.

    wl-paste fork+exec:ar ett eget `cat`-barn som ärver vårt stdout-rör. Att döda
    bara wl-paste lämnar `cat` kvar med röret öppet, och `proc.stdout.read()` står
    då kvar för evigt: kommandot hänger och barnet blir kvar som process (HANCORE,
    ärende 10821). Därför startas källan i en egen processgrupp (start_new_session
    i paste_bounded) och dödas som grupp. `klar` sätts när vi är färdiga med
    processen, så en släpande dödare inte kan träffa en återanvänd pid.
    """
    if klar.is_set():
        return
    try:
        os.killpg(proc.pid, signal.SIGKILL)     # start_new_session: barnet är gruppledare
    except OSError:
        try:
            proc.kill()
        except OSError:
            pass


def bounded_run(cmd, data=None, limit=None, timeout=None):
    """Kör ett kommando i egen processgrupp med tak på tid OCH på hur mycket som
    läses tillbaka. Ger (rc, utdata). `data` (bytes) skickas på stdin om den ges.

    Tre saker måste hålla samtidigt, och de är samma fynd i tre steg (HANCORE,
    ärende 10821):

    * **Minne.** subprocess.run(capture_output=True) buffrar HELA strömmen innan
      någon hinner se den, så en källa som strömmar utan slut äter upp
      CLI-processens minne innan taket hinner verka. Här läses 64 KiB i taget
      tills taket, och källan dödas om den fortsätter.
    * **Tid.** En ägare som slutar skriva utan att stänga fönstret får inte hålla
      kommandot — och på en förfrågningsväg (/status, /clip) får den inte hålla en
      server-tråd för evigt: 32 sådana tar hela anslutningstaket.
    * **Barnen.** wl-paste fork+exec:ar ett eget `cat`-barn som ärver vårt
      stdout-rör. Att döda bara föräldern lämnar `cat` kvar med röret öppet, och
      proc.stdout.read() står då kvar för evigt (mätt: blockerad >20 s efter att
      vakthunden slagit till, med barnet kvar som process). Därför startas källan
      i en egen processgrupp (start_new_session) och dödas som grupp.

    Läses först efter att stdin är skriven och stängd, så ett kommando som skriver
    mycket utdata inte kan låsa sig mot en skrivning i tur och ordning.
    """
    timeout = CLIP_TIMEOUT if timeout is None else timeout
    limit = CLIP_MAX if limit is None else limit
    klar = threading.Event()
    proc = subprocess.Popen(list(cmd),
                            stdin=subprocess.PIPE if data is not None else subprocess.DEVNULL,
                            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                            start_new_session=True)
    dodare = threading.Timer(timeout, kill_source, (proc, klar))
    dodare.start()
    bitar, n = [], 0
    try:
        if data is not None:
            try:
                proc.stdin.write(data)
                proc.stdin.close()
            except OSError:
                pass
        while n <= limit:
            bit = proc.stdout.read(65536)
            if not bit:
                break
            bitar.append(bit)
            n += len(bit)
        if n > limit:
            kill_source(proc, klar)         # källan har mer — vi är klara ändå
        klar.set()
        proc.wait(timeout=timeout)
    except (subprocess.TimeoutExpired, OSError):
        kill_source(proc, klar)
    finally:
        klar.set()
        dodare.cancel()
    data_ut = b"".join(bitar)[:limit]
    rc = 0 if data_ut else (proc.returncode if proc.returncode is not None else 1)
    return rc, data_ut


def paste_bounded(*cmd):
    """wl-paste → sloten. Tunt skal över bounded_run: taken är urklippets."""
    return bounded_run(list(cmd))


def write_clip(text):
    """Lägger texten i den delade urklippsloten. 0600 — ett urklipp kan vara ett
    lösenord."""
    write_private(CLIP_PATH, text[:CLIP_MAX])


def read_clip():
    """Sloten, eller tomt om inget delats. Telefonen läser den bara när man
    trycker — servern skickar aldrig PC:ns urklipp av sig själv."""
    try:
        with open(CLIP_PATH, "rb") as fh:
            return fh.read()[:CLIP_MAX]
    except OSError:
        return b""


def generate_qr(url):
    """True om QR-filen finns och är för aktuell URL. Aldrig tyst: skälet hamnar i
    loggen och som qr_ok=False i status.

    URL:en (som bär token) går på qrencodes **stdin**, aldrig som argument: en
    annan lokal användare kan läsa argv ur processlistan och hade då fått token.
    PNG:en kommer tillbaka på qrencodes stdout och skrivs med write_private, så
    filen är 0600 redan när den skapas — förut skrev qrencode den själv genom
    umask, och en efterföljande chmod har samma fönster som det tidigare fyndet
    (HANCORE, ärende 10821). Körningen är takad: /status-vägen får inte kunna
    hållas av en qrencode som inte blir klar.
    """
    try:
        with open(URL_FILE) as fh:
            current = fh.read().strip()
    except OSError:
        current = ""
    if current == url and os.path.exists(QR_PATH):
        return True
    if not shutil.which("qrencode"):
        log("qrencode saknas — ingen QR-kod kan skapas")
        return False
    rc, png = bounded_run(["qrencode", "-s", "6", "-m", "2", "-o", "-"], data=url.encode(), limit=1 << 20)
    if rc != 0 or not png.startswith(b"\x89PNG"):
        log("qrencode misslyckades (rc=%s, %d byte)" % (rc, len(png)))
        return False
    write_private(QR_PATH, png)
    write_private(URL_FILE, url)
    return True


def stale_publishers():
    """Pidar för avahi-publicerare av VÅRT namn som inte är våra egna barn.

    En server som dödats hårt (SIGKILL, OOM) lämnar sin publicerare kvar, och då
    är namnet upptaget av en process som pekar på en dörr ingen öppnat: nästa
    avahi-publish får ett annat namn (sling-2.local) medan panelen visar
    sling.local. Mätt: en kvarglömd `avahi-publish-service -s sling _http._tcp
    5399` levde vidare efter att servern dödats med -9, och ingenting lyssnade på
    porten. Samma namn kan bara en publicera — den senaste starten vinner.

    Formen räknas, inte namnet: argv[0] ska vara avahi-publish-service och
    argv[1:3] exakt ["-s", MDNS_NAME]. Förut räckte det att en främmande process
    nämnde båda strängarna någonstans i sin kommandorad, och en sådan dödades av
    start_mdns (mätt: en process med ["avahi-publish-service", "sling"] i argv).
    Porten lämnas utanför jämförelsen: en kvarglömd publicerare kan peka på en
    gammal port.
    """
    pids = []
    for n in os.listdir("/proc"):
        if not n.isdigit():
            continue
        try:
            with open("/proc/%s/cmdline" % n, "rb") as fh:
                argv = [a for a in fh.read().decode("utf-8", "replace").split("\0") if a]
        except OSError:
            continue
        if not argv:
            continue
        # Två former räknas: den riktiga binären (argv[0] är namnet) och ett
        # skal/manus med shebang (då är argv[0] tolken och argv[1] sökvägen).
        # I båda fallen måste flaggan och tjänstenamnet stå direkt efter.
        if os.path.basename(argv[0]) == "avahi-publish-service":
            rest = argv[1:]
        elif len(argv) > 1 and os.path.basename(argv[1]) == "avahi-publish-service":
            rest = argv[2:]
        else:
            continue
        if rest[:2] == ["-s", MDNS_NAME]:
            pids.append(int(n))
    return pids


def start_mdns():
    """Publicerar sling.local → den här datorn, en adress att minnas som
    överlever att DHCP byter IP. QR-koden använder ändå IP:t: Android löser
    inte .local pålitligt, och en QR som inte fungerar är värre än ett IP."""
    for gammal in stale_publishers():
        if gammal != os.getpid():
            try:
                os.kill(gammal, signal.SIGTERM)     # ta tillbaka namnet först
            except OSError:
                pass
    if not shutil.which("avahi-publish-service"):
        return None
    try:
        p = subprocess.Popen(["avahi-publish-service", "-s", MDNS_NAME, "_http._tcp", str(PORT)],
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        return None
    time.sleep(0.4)
    return p if p.poll() is None else None


# ------------------------------------------------------------------------------
# Multipart som strömmar till disk
# ------------------------------------------------------------------------------
def safe_upload_name(raw):
    """Filnamnet ur en multipart-rubrik — eller "" om det inte får bli en fil.

    Mätt: `open()` på ett namn med NUL kastar ValueError, som do_POST:s except OSError
    inte fångar; då dör anropet utan svar och de filer som kom efter i samma POST
    försvinner tyst. Ett namn med radbrytning skulle skriva egna rader i loggen.
    """
    name = os.path.basename(raw)
    if not name or name in (".", "..") or len(name.encode("utf-8", "replace")) > 200:
        return ""
    if any(ord(ch) < 32 for ch in name):
        return ""
    return name


def stream_multipart(rfile, content_type, content_length, save_dir, on_progress=None):
    """Läser multipart-kroppen i bitar och skriver varje fil direkt till disk.

    on_progress(byte, namn) kallas efter varje läst bit (och en gång när en ny
    dels filnamn är känt), så panelen kan visa hur långt en stor fil har kommit.

    Mätt: den tidigare varianten (rfile.read(hela kroppen) + split(boundary)) tog
    540 MB RSS för en 150 MB-fil — en 1 GB-video hade krävt ~3,5 GB.

    ponytail: bufferten behåller len(gräns)+4 byte mellan varven, vilket räcker för
    att en gräns som delas av två läsningar inte hamnar i filen. Ingen Range-
    uppladdning och ingen omsändning — kroppen kommer i en POST.
    """
    m = re.search(r"boundary=(.+)", content_type)
    if not m:
        return []
    delim = b"--" + m.group(1).strip("\"'").encode()
    keep = len(delim) + 4

    buf = b""
    remaining = content_length
    out = None                      # (namn, filhandtag)
    saved = []
    state = "preamble"              # preamble -> headers -> data -> headers ...

    def close_part(behall=True):
        """Stänger delen. behall=False kastar den i stället: en avbruten uppladdning
        lämnade förut en halv fil i Received som såg hel ut (mätt: 599 863 av
        2 000 139 byte, utan markering), och telefonen visste bara att anslutningen
        dog."""
        nonlocal out
        if out:
            out[1].close()
            if behall:
                saved.append(out[0])
            else:
                try:
                    os.remove(os.path.join(save_dir, out[0]))
                except OSError:
                    pass
            out = None

    def tell(nbytes=0, name=None):
        if on_progress:
            on_progress(nbytes, name)

    while remaining > 0:
        try:
            chunk = rfile.read(min(262144, remaining))
        except BaseException:
            # Klienten försvann (eller slog i läsdeadlinen) mitt i en del: kasta
            # den halva filen i stället för att lämna den som såg hel ut.
            close_part(behall=False)
            raise
        if not chunk:
            break
        remaining -= len(chunk)
        tell(len(chunk))
        buf += chunk

        while True:
            if state == "preamble":
                i = buf.find(delim)
                if i < 0:
                    # Skräp före första gränsen kan vara hur stort som helst.
                    if len(buf) > 1_000_000:
                        buf = buf[-keep:]
                    break
                buf = buf[i + len(delim):]
                if buf.startswith(b"--"):
                    return saved
                state = "headers"

            elif state == "headers":
                # Rubrikerna för den del vi står i ligger först i bufferten. De får
                # aldrig kastas: gjorde man det tappades filen (mätt — 2 av 4 filer
                # försvann när nästa dels rubriker trimmades bort).
                j = buf.find(b"\r\n\r\n")
                if j < 0:
                    if len(buf) > 1_000_000:
                        return saved
                    break
                headers = buf[:j].decode("utf-8", "replace")
                buf = buf[j + 4:]
                fn = re.search(r'filename="([^"]*)"', headers)
                name = safe_upload_name(fn.group(1)) if fn else ""
                if name:
                    name, fh = create_unique(save_dir, name)
                    out = (name, fh)
                    tell(0, name)
                state = "data"

            else:                                    # data
                i = buf.find(delim)
                if i < 0:
                    if len(buf) > keep:
                        data, buf = buf[:-keep], buf[-keep:]
                        if out:
                            out[1].write(data)
                    break
                data = buf[:i]
                if data.endswith(b"\r\n"):
                    data = data[:-2]
                if out:
                    out[1].write(data)
                buf = buf[i + len(delim):]
                close_part()
                if buf.startswith(b"--"):
                    return saved          # slutgräns
                state = "headers"          # nästa dels rubriker ligger först i bufferten

    # Strömmen tog slut utan slutgräns: den sista delen är halv och kastas.
    close_part(behall=False)
    return saved



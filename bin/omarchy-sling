#!/usr/bin/env python3
# ==============================================================================
# Sling (Omarchy File Drop Daemon & CLI)
# Part of Sling - https://github.com/alexwest1981/Sling
#
# Säkerhetsmodell: servern lyssnar på LAN:et, men varje förfrågan måste bära en
# token i sökvägen (/t/<token>/...). Token skapas vid start, byts varje gång och
# följer med i QR-koden. Servern avväpnar sig själv efter SLING_IDLE_TIMEOUT
# sekunder utan trafik.
# ==============================================================================

import html
import json
import os
import re
import secrets
import shutil
import signal
import socket
import stat
import subprocess
import sys
import tempfile
import threading
import time
import urllib.parse
import urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

VERSION = "1.3.0"
PORT = int(os.environ.get("SLING_PORT", 5380))
IDLE_TIMEOUT = int(os.environ.get("SLING_IDLE_TIMEOUT", 900))
MAX_UPLOAD = int(os.environ.get("SLING_MAX_UPLOAD", 2 * 1024**3))
# Tak för samtidiga anslutningar och tystnad per anslutning. Token kontrolleras
# först när förfrågan är läst, så utan tak kan en granne på LAN:et öppna
# anslutningar, tiga, och hålla en tråd och en fildeskriptor per anslutning.
MAX_CONNECTIONS = int(os.environ.get("SLING_MAX_CONNECTIONS", 32))
CLIP_MAX = int(os.environ.get("SLING_CLIP_MAX", 64 * 1024))
# Hur länge en klippkälla får hålla kommandot. En ägare som slutar skriva utan att
# stänga får inte hänga "Send clipboard to phone".
CLIP_TIMEOUT = float(os.environ.get("SLING_CLIP_TIMEOUT", "5"))
SOCKET_TIMEOUT = int(os.environ.get("SLING_SOCKET_TIMEOUT", 30))
MDNS_NAME = os.environ.get("SLING_MDNS_NAME", "sling")
# Sätts av cmd_server när avahi-publish-service faktiskt kör. Panelen visar
# mDNS-adressen som "adressen att minnas", så den får bara visas när något
# publicerar den: saknas avahi, eller tar namnet slut, är http://<namn>.local
# en adress som inte svarar (mätt: adressen visades även när publiceringen
# misslyckades direkt).
MDNS_UP = False

BASE_DIR = os.path.expanduser(os.environ.get("SLING_BASE_DIR", "~/Downloads/Sling"))
RECEIVED_DIR = os.path.join(BASE_DIR, "Received")
SEND_DIR = os.path.join(BASE_DIR, "Send")
# Urklippet PC:n delar med telefonen. En punktfil utanför Send/, så den varken
# listas som hämtbar fil eller blandas ihop med dem. 0600: urklipp kan vara
# lösenord.
CLIP_PATH = os.path.join(BASE_DIR, ".clipboard")

# Tillståndet (token, pid, url, qr) får bara ligga där ingen annan lokal användare kan
# skriva. XDG_RUNTIME_DIR är per användare och 0700; finns den inte får vi INTE falla
# tillbaka på /tmp — vem som helst kan skapa /tmp/sling först, äga katalogen och läsa
# token ur den (och byta pid-filen). Fall tillbaka på samma privata plats som loggen.
STATE_ROOT = os.environ.get("XDG_RUNTIME_DIR") or os.path.join(
    os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")), "run")
STATE_DIR = os.path.join(STATE_ROOT, "sling")
QR_PATH = os.path.join(STATE_DIR, "qr.png")
URL_FILE = os.path.join(STATE_DIR, "url")
PID_FILE = os.path.join(STATE_DIR, "pid")
TOKEN_FILE = os.path.join(STATE_DIR, "token")
LOG_DIR = os.path.join(os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")), "sling")
LOG_PATH = os.path.join(LOG_DIR, "server.log")

DEFAULT_BASE = os.path.join(os.path.expanduser("~"), "Downloads", "Sling")


def harden_dirs():
    """Sätter mode på katalogerna och skapar loggen 0600 innan någon skriver i den.

    Tillstånds- och loggkatalogen bär token, pid och namnen på mottagna filer: är de
    inte våra egna (en främmande ägare eller en symlink någon planterat) vägrar vi
    hellre än skriver dit. Övriga kataloger härdas bara när de är den egna basen —
    pekar SLING_BASE_DIR någon annanstans kan det vara en katalog användaren valt att
    dela, och att chmodda den vore att ändra något vi inte äger. Loggen skapas 0600
    här, så att cmd_starts open(..., "a") ärver rätt mode i stället för umaskens.
    """
    for path in (BASE_DIR, RECEIVED_DIR, SEND_DIR, STATE_DIR, LOG_DIR):
        privat = path in (STATE_DIR, LOG_DIR)
        if privat and os.path.islink(path):
            raise SystemExit("Sling: %s är en symlink — vägrar lägga token, pid och "
                             "logg där någon annan kan ha placerat den." % path)
        if privat and os.path.exists(path) and os.stat(path).st_uid != os.getuid():
            raise SystemExit("Sling: %s ägs av någon annan — vägrar lägga token, pid "
                             "och logg där." % path)
        os.makedirs(path, mode=0o700, exist_ok=True)
        if not os.path.isdir(path) or os.stat(path).st_uid != os.getuid():
            raise SystemExit("Sling: %s ägs inte av dig — vägrar använda den." % path)
        # Redan skapade kataloger behåller sin gamla mode; sätt om varje gång.
        if privat or path == DEFAULT_BASE or path.startswith(DEFAULT_BASE + os.sep):
            try:
                os.chmod(path, 0o700)
            except OSError:
                pass
    if os.path.exists(LOG_PATH):
        os.chmod(LOG_PATH, 0o600)
    else:
        os.close(os.open(LOG_PATH, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600))


harden_dirs()

LAST_ACTIVITY = {"t": time.monotonic()}
_TOKEN = ""
# Sätts i cmd_server: den processen ÄR servern och får inte hämta sin egen status.
IS_SERVER = False

# Pågående överföring — panelen ritar en förloppsindikator av den här posten.
# ponytail: en global post, sista skrivaren vinner. Räcker för en telefon i taget;
# en dict per anslutning om flera samtidiga överföringar ska visas var för sig.
ACTIVE = {"dir": "", "name": "", "done": 0, "total": 0, "t0": 0.0}


def start_transfer(direction, name, total):
    ACTIVE.update({"dir": direction, "name": name, "done": 0, "total": total, "t0": time.monotonic()})


def bump_transfer(nbytes):
    ACTIVE["done"] += nbytes
    # En pågående överföring är trafik. Avväpningstimern räknade bara förfrågningar,
    # så en överföring som tog längre tid än SLING_IDLE_TIMEOUT kapades mitt i —
    # mätt med taket satt till 2 s: BrokenPipe efter 3,6 s och ingen fil på disk.
    # Panelen håller timern levande med sin poll, men en server startad som
    # `omarchy-sling start` i en terminal har ingen poll. En klient som slutar
    # skicka bumpar inte längre, så taket gäller fortfarande för en tyst transfer.
    LAST_ACTIVITY["t"] = time.monotonic()


def end_transfer():
    ACTIVE.update({"dir": "", "name": "", "done": 0, "total": 0, "t0": 0.0})


def active_dict():
    """None när inget pågår; annars läge, procent och fart för panelen."""
    if not ACTIVE["dir"]:
        return None
    total, done = ACTIVE["total"], ACTIVE["done"]
    elapsed = max(time.monotonic() - ACTIVE["t0"], 0.001)
    return {
        "dir": ACTIVE["dir"],
        "name": ACTIVE["name"],
        "done": done,
        "total": total,
        "pct": int(done * 100 / total) if total else 0,
        "speed": done / elapsed,
        "human_done": human_size(done),
        "human_total": human_size(total),
    }


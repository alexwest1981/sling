#!/usr/bin/env python3
# ==============================================================================
# Sling (Omarchy File Drop Daemon & CLI)
# Part of Sling - https://github.com/alexwest1981/Sling
#
# Säkerhetsmodell: servern lyssnar på LAN:et, men varje förfrågan måste bära en
# token i sökvägen (/t/<token>/...). Token skapas vid start, byts varje gång och
# följer med i QR-koden. Servern avväpnar sig själv efter SLING_IDLE_TIMEOUT
# sekunder utan trafik.
# ==============================================================================

import html
import json
import os
import re
import secrets
import shutil
import signal
import socket
import subprocess
import sys
import threading
import time
import urllib.parse
import urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

VERSION = "1.2.1"
PORT = int(os.environ.get("SLING_PORT", 5380))
IDLE_TIMEOUT = int(os.environ.get("SLING_IDLE_TIMEOUT", 900))
MAX_UPLOAD = int(os.environ.get("SLING_MAX_UPLOAD", 2 * 1024**3))
MDNS_NAME = os.environ.get("SLING_MDNS_NAME", "sling")

BASE_DIR = os.path.expanduser(os.environ.get("SLING_BASE_DIR", "~/Downloads/Sling"))
RECEIVED_DIR = os.path.join(BASE_DIR, "Received")
SEND_DIR = os.path.join(BASE_DIR, "Send")

STATE_DIR = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "sling")
QR_PATH = os.path.join(STATE_DIR, "qr.png")
URL_FILE = os.path.join(STATE_DIR, "url")
PID_FILE = os.path.join(STATE_DIR, "pid")
TOKEN_FILE = os.path.join(STATE_DIR, "token")
LOG_DIR = os.path.join(os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")), "sling")
LOG_PATH = os.path.join(LOG_DIR, "server.log")

for _d in (RECEIVED_DIR, SEND_DIR, STATE_DIR, LOG_DIR):
    # 0700: loggen namnger mottagna filer — ingen annan lokal användare ska kunna läsa den.
    os.makedirs(_d, mode=0o700, exist_ok=True)
    if _d in (STATE_DIR, LOG_DIR):
        # Redan skapade kataloger behåller sin gamla mode; sätt om varje gång.
        try:
            os.chmod(_d, 0o700)
        except OSError:
            pass
if os.path.exists(LOG_PATH):
    try:
        os.chmod(LOG_PATH, 0o600)
    except OSError:
        pass

LAST_ACTIVITY = {"t": time.monotonic()}
_TOKEN = ""
# Sätts i cmd_server: den processen ÄR servern och får inte hämta sin egen status.
IS_SERVER = False

# Pågående överföring — panelen ritar en förloppsindikator av den här posten.
# ponytail: en global post, sista skrivaren vinner. Räcker för en telefon i taget;
# en dict per anslutning om flera samtidiga överföringar ska visas var för sig.
ACTIVE = {"dir": "", "name": "", "done": 0, "total": 0, "t0": 0.0}


def start_transfer(direction, name, total):
    ACTIVE.update({"dir": direction, "name": name, "done": 0, "total": total, "t0": time.monotonic()})


def bump_transfer(nbytes):
    ACTIVE["done"] += nbytes


def end_transfer():
    ACTIVE.update({"dir": "", "name": "", "done": 0, "total": 0, "t0": 0.0})


def active_dict():
    """None när inget pågår; annars läge, procent och fart för panelen."""
    if not ACTIVE["dir"]:
        return None
    total, done = ACTIVE["total"], ACTIVE["done"]
    elapsed = max(time.monotonic() - ACTIVE["t0"], 0.001)
    return {
        "dir": ACTIVE["dir"],
        "name": ACTIVE["name"],
        "done": done,
        "total": total,
        "pct": int(done * 100 / total) if total else 0,
        "speed": done / elapsed,
        "human_done": human_size(done),
        "human_total": human_size(total),
    }

# ------------------------------------------------------------------------------
# Notiser i18n (datorns språk)
# ------------------------------------------------------------------------------
NOTIF_STRINGS = {
    "en": {"received_single": "📥 Sling: 1 new file received", "received_multi": "📥 Sling: {count} new files received"},
    "sv": {"received_single": "📥 Sling: 1 ny fil mottagen", "received_multi": "📥 Sling: {count} nya filer mottagna"},
    "nl": {"received_single": "📥 Sling: 1 nieuw bestand ontvangen", "received_multi": "📥 Sling: {count} nieuwe bestanden ontvangen"},
    "ja": {"received_single": "📥 Sling: 1件のファイルを受信しました", "received_multi": "📥 Sling: {count}件のファイルを受信しました"},
    "de": {"received_single": "📥 Sling: 1 neue Datei empfangen", "received_multi": "📥 Sling: {count} neue Dateien empfangen"},
    "fr": {"received_single": "📥 Sling: 1 nouveau fichier reçu", "received_multi": "📥 Sling: {count} nouveaux fichiers reçus"},
    "es": {"received_single": "📥 Sling: 1 archivo nuevo recibido", "received_multi": "📥 Sling: {count} archivos nuevos recibidos"},
    "zh": {"received_single": "📥 Sling: 收到 1 个新文件", "received_multi": "📥 Sling: 收到 {count} 个新文件"},
}


def get_system_lang():
    lang_env = os.environ.get("LANG", "en_US.UTF-8").split(".")[0].split("_")[0].lower()
    return lang_env if lang_env in NOTIF_STRINGS else "en"


def log(msg):
    try:
        fd = os.open(LOG_PATH, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
        with os.fdopen(fd, "a") as fh:
            fh.write("%s  %s\n" % (time.strftime("%Y-%m-%d %H:%M:%S"), msg))
    except OSError:
        pass


# ------------------------------------------------------------------------------
# Nätverk och filer
# ------------------------------------------------------------------------------
def get_local_ip():
    """IP:t telefonen ska använda.

    UDP-knepet ger rätt interface utan att skicka ett paket. Saknas default-route
    (isolerat nät, hotspot utan gateway) faller vi tillbaka på första globala
    IPv4-adressen — gamla koden gav då 127.0.0.1, vilket pekar på telefonen själv
    och gör QR-koden verkningslös.
    """
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.connect(("1.1.1.1", 80))
        ip = s.getsockname()[0]
        s.close()
        if ip and not ip.startswith("127."):
            return ip
    except OSError:
        pass
    try:
        out = subprocess.run(["ip", "-4", "-o", "addr", "show", "scope", "global"],
                             capture_output=True, text=True, timeout=5).stdout
        m = re.search(r"inet (\d+\.\d+\.\d+\.\d+)", out)
        if m:
            return m.group(1)
    except Exception:
        pass
    return "127.0.0.1"


def port_open(host="127.0.0.1", port=None):
    s = socket.socket()
    s.settimeout(0.3)
    try:
        return s.connect_ex((host, port or PORT)) == 0
    finally:
        s.close()


def server_url(token, host=None):
    return "http://%s:%d/t/%s/" % (host or get_local_ip(), PORT, token)


def read_token():
    try:
        with open(TOKEN_FILE) as fh:
            return fh.read().strip()
    except OSError:
        return ""


def current_token():
    """Token för den här processen. Cachas: skulle filen försvinna mitt i körningen
    ska servern inte plötsligt släppa igenom vilken sökväg som helst."""
    global _TOKEN
    if not _TOKEN:
        _TOKEN = read_token()
    return _TOKEN


def human_size(size):
    """GB-nivån behövs: en 2 GB-video ska inte stå som '2048.0 MB' i panelen."""
    if size >= 1024 ** 3:
        return "%.2f GB" % (size / 1024 ** 3)
    if size >= 1024 ** 2:
        return "%.1f MB" % (size / 1024 ** 2)
    return "%.1f KB" % (size / 1024)


def unique_path(directory, filename):
    dest = os.path.join(directory, filename)
    base, ext = os.path.splitext(filename)
    counter = 1
    while os.path.exists(dest):
        dest = os.path.join(directory, "%s_%d%s" % (base, counter, ext))
        counter += 1
    return dest


def list_files(directory, limit=None):
    if not os.path.isdir(directory):
        return []
    names = [f for f in os.listdir(directory) if os.path.isfile(os.path.join(directory, f))]
    names.sort(key=lambda f: os.path.getmtime(os.path.join(directory, f)), reverse=True)
    if limit:
        names = names[:limit]
    return [{"name": f, "size": human_size(os.path.getsize(os.path.join(directory, f)))} for f in names]


def generate_qr(url):
    """True om QR-filen finns och är för aktuell URL. Aldrig tyst: skälet hamnar i
    loggen och som qr_ok=False i status.

    URL:en (som bär token) går på qrencodes **stdin**, aldrig som argument: en
    annan lokal användare kan läsa argv ur processlistan och hade då fått token.
    """
    try:
        with open(URL_FILE) as fh:
            current = fh.read().strip()
    except OSError:
        current = ""
    if current == url and os.path.exists(QR_PATH):
        return True
    if not shutil.which("qrencode"):
        log("qrencode saknas — ingen QR-kod kan skapas")
        return False
    r = subprocess.run(["qrencode", "-s", "6", "-m", "2", "-o", QR_PATH],
                       input=url.encode(), capture_output=True)
    if r.returncode != 0 or not os.path.exists(QR_PATH):
        log("qrencode misslyckades: " + (r.stderr or b"").decode("utf-8", "replace").strip())
        return False
    with open(URL_FILE, "w") as fh:
        fh.write(url)
    os.chmod(URL_FILE, 0o600)
    return True


def start_mdns():
    """Publicerar sling.local → den här datorn, en adress att minnas som
    överlever att DHCP byter IP. QR-koden använder ändå IP:t: Android löser
    inte .local pålitligt, och en QR som inte fungerar är värre än ett IP."""
    if not shutil.which("avahi-publish-service"):
        return None
    try:
        p = subprocess.Popen(["avahi-publish-service", "-s", MDNS_NAME, "_http._tcp", str(PORT)],
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        return None
    time.sleep(0.4)
    return p if p.poll() is None else None


# ------------------------------------------------------------------------------
# Multipart som strömmar till disk
# ------------------------------------------------------------------------------
def stream_multipart(rfile, content_type, content_length, save_dir, on_progress=None):
    """Läser multipart-kroppen i bitar och skriver varje fil direkt till disk.

    on_progress(byte, namn) kallas efter varje läst bit (och en gång när en ny
    dels filnamn är känt), så panelen kan visa hur långt en stor fil har kommit.

    Mätt: den tidigare varianten (rfile.read(hela kroppen) + split(boundary)) tog
    540 MB RSS för en 150 MB-fil — en 1 GB-video hade krävt ~3,5 GB.

    ponytail: bufferten behåller len(gräns)+4 byte mellan varven, vilket räcker för
    att en gräns som delas av två läsningar inte hamnar i filen. Ingen Range-
    uppladdning och ingen omsändning — kroppen kommer i en POST.
    """
    m = re.search(r"boundary=(.+)", content_type)
    if not m:
        return []
    delim = b"--" + m.group(1).strip("\"'").encode()
    keep = len(delim) + 4

    buf = b""
    remaining = content_length
    out = None                      # (sökväg, filhandtag)
    saved = []
    state = "preamble"              # preamble -> headers -> data -> headers ...

    def close_part():
        nonlocal out
        if out:
            out[1].close()
            saved.append(os.path.basename(out[0]))
            out = None

    def tell(nbytes=0, name=None):
        if on_progress:
            on_progress(nbytes, name)

    while remaining > 0:
        chunk = rfile.read(min(65536, remaining))
        if not chunk:
            break
        remaining -= len(chunk)
        tell(len(chunk))
        buf += chunk

        while True:
            if state == "preamble":
                i = buf.find(delim)
                if i < 0:
                    # Skräp före första gränsen kan vara hur stort som helst.
                    if len(buf) > 1_000_000:
                        buf = buf[-keep:]
                    break
                buf = buf[i + len(delim):]
                if buf.startswith(b"--"):
                    return saved
                state = "headers"

            elif state == "headers":
                # Rubrikerna för den del vi står i ligger först i bufferten. De får
                # aldrig kastas: gjorde man det tappades filen (mätt — 2 av 4 filer
                # försvann när nästa dels rubriker trimmades bort).
                j = buf.find(b"\r\n\r\n")
                if j < 0:
                    if len(buf) > 1_000_000:
                        return saved
                    break
                headers = buf[:j].decode("utf-8", "replace")
                buf = buf[j + 4:]
                fn = re.search(r'filename="([^"]*)"', headers)
                name = os.path.basename(fn.group(1)) if fn else ""
                if name:
                    path = unique_path(save_dir, name)
                    out = (path, open(path, "wb"))
                    tell(0, name)
                state = "data"

            else:                                    # data
                i = buf.find(delim)
                if i < 0:
                    if len(buf) > keep:
                        data, buf = buf[:-keep], buf[-keep:]
                        if out:
                            out[1].write(data)
                    break
                data = buf[:i]
                if data.endswith(b"\r\n"):
                    data = data[:-2]
                if out:
                    out[1].write(data)
                buf = buf[i + len(delim):]
                close_part()
                if buf.startswith(b"--"):
                    return saved          # slutgräns
                state = "headers"          # nästa dels rubriker ligger först i bufferten

    close_part()
    return saved



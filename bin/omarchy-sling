                }})
                .catch(() => {{ clipGet.innerText = t.conn_error; }});
        }});
    </script>
</body>
</html>"""


class SlingHandler(BaseHTTPRequestHandler):
    server_version = "Sling/" + VERSION
    protocol_version = "HTTP/1.1"

    def setup(self):
        """Nagle av på serverhållet — mobilen ACK:ar fördröjt, och det sista
        delsegmentet i en skrivning kunde bli liggande i väntan på det.

        Mätt 2026-10-10, loopback 256 MB, 6 körningar per variant: 64 KB- och
        256 KB-block ligger båda på ~4,0 GB/s (median 4043 mot 4078 MB/s) — det
        är CPU-bundet på loopback och ingen mätbar skillnad. Den rapporterade
        Wi-Fi-strypningen (0,5–1,5 MB/s) går inte att återskapa härifrån, så
        flaggan står kvar som billig härdning, inte som bevisad fix.
        SNDBUF/RCVBUF lämnas åt kerneln: autotuning växer förbi 1 MB vid behov,
        en fast gräns gör det inte.

        Tidsgränsen per anslutning: den som ansluter och sedan tiger ska inte
        hålla en tråd och en fildeskriptor. Gränsen gäller varje läsning och
        skrivning, inte hela överföringen — en långsam men levande telefon
        klarar sig, och en död anslutning kastas av handle_one_request.
        """
        super().setup()
        try:
            self.connection.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
            self.connection.settimeout(SOCKET_TIMEOUT)
        except OSError:
            pass

    def log_message(self, fmt, *args):
        pass

    def _resolve(self):
        """Sökvägen efter token-prefixet, annars None (→ 403)."""
        path = urllib.parse.urlparse(self.path).path
        prefix = "/t/%s" % current_token()
        if current_token() and path.startswith(prefix):
            LAST_ACTIVITY["t"] = time.monotonic()
            return path[len(prefix):] or "/"
        return None

    def _send(self, code, body=b"", ctype="text/plain; charset=utf-8", extra=None):
        self.send_response(code)
        if body:
            self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        for key, value in (extra or {}).items():
            self.send_header(key, value)
        self.end_headers()
        if body:
            self.wfile.write(body)

    def _no_token(self):
        self._send(403, ("Sling is running. Use the link or QR code from the bar panel.\n"
                         "Sling körs. Använd länken eller QR-koden i panelen.\n").encode())

    def do_HEAD(self):
        rest = self._resolve()
        if rest is None:
            self._no_token()
        else:
            self._send(200)

    def do_GET(self):
        rest = self._resolve()
        if rest is None:
            self._no_token()
            return

        if rest in ("/", "/index.html"):
            send_files = list_files(SEND_DIR)
            rows = "".join(
                '<div class="file-item"><div class="file-info"><span class="file-name">📄 %s</span>'
                '<span class="file-size">%s</span></div>'
                '<a href="download/%s" class="dl-btn t-dl-btn" download>Download</a></div>'
                % (html.escape(f["name"]), f["size"], urllib.parse.quote(f["name"]))
                for f in send_files)
            page = PAGE.format(download_display="display: block;" if send_files else "display: none;",
                               file_rows=rows).encode()
            self._send(200, page, "text/html; charset=utf-8", {"Cache-Control": "no-store"})

        elif rest == "/status":
            self._send(200, json.dumps(status_dict(True)).encode(), "application/json")

        elif rest == "/clip":
            # Det PC-användaren delat. Skrivs bara av cmd_clip, aldrig av servern.
            self._send(200, read_clip(), "text/plain; charset=utf-8", {"Cache-Control": "no-store"})

        elif rest.startswith("/download/"):
            name = os.path.basename(urllib.parse.unquote(rest[len("/download/"):]))
            # Öppna först och mät sedan den inode vi faktiskt har: kön kan rensas
            # eller filen bytas ut mellan en kontroll och öppnandet, och en
            # Content-Length tagen från en annan inode ger klienten en halv kropp
            # (samma klass som list_files — mätt: 3092 av 5634 anrop dog utan svar).
            handtag = None
            if name:
                try:
                    handtag = open(os.path.join(SEND_DIR, name), "rb")
                except OSError:
                    handtag = None
            if handtag is None:
                self._send(404)
                return
            with handtag:
                size = os.fstat(handtag.fileno()).st_size
                self.send_response(200)
                self.send_header("Content-Type", "application/octet-stream")
                # RFC 5987-formen klarar icke-ASCII och kan inte injicera rubriker.
                self.send_header("Content-Disposition", "attachment; filename*=UTF-8''" + urllib.parse.quote(name))
                self.send_header("Content-Length", str(size))
                self.end_headers()
                start_transfer("down", name, size)
                try:
                    while chunk := handtag.read(262144):   # färre väckningar per byte, mätt lika snabbt som 64 KB
                        self.wfile.write(chunk)
                        bump_transfer(len(chunk))
                except (BrokenPipeError, ConnectionResetError):
                    log("avbruten nedladdning: %s" % name)
                finally:
                    end_transfer()

        else:
            self._send(404)

    def _receive_clip(self):
        """Text från telefonen → PC:ns urklipp, via wl-copy på stdin."""
        try:
            length = int(self.headers.get("Content-Length", 0))
        except ValueError:
            length = 0
        if length <= 0:
            self._send(400, json.dumps({"ok": False, "error": "empty"}).encode(), "application/json")
            return
        if length > CLIP_MAX:
            # Läs och släng kroppen innan svaret, samma skäl som för uppladdningen.
            self.close_connection = True
            drain = min(length, 8 * 1024 * 1024)
            while drain > 0:
                chunk = self.rfile.read(min(65536, drain))
                if not chunk:
                    break
                drain -= len(chunk)
            self._send(413, json.dumps({"ok": False, "error": "too large"}).encode(), "application/json")
            return
        text = self.rfile.read(length)
        if not shutil.which("wl-copy"):
            self._send(503, json.dumps({"ok": False, "error": "wl-copy missing"}).encode(), "application/json")
            return
        # Takad körning: en wl-copy som inte blir klar får inte hålla en server-tråd
        # för evigt — 32 sådana tar hela anslutningstaket och servern nekar alla.
        rc, _ = bounded_run(["wl-copy"], data=text)
        if rc != 0:
            self._send(500, json.dumps({"ok": False, "error": "wl-copy failed"}).encode(), "application/json")
            return
        # Notisen säger bara att något kommit — innehållet är privat metadata och
        # hör inte i argv (där låg filnamnen förut). Takad körning: en notis som
        # aldrig blir klar får inte hålla förfrågan (samma klass som wl-copy och
        # qrencode — mätt: ett hängande notify-send lämnade uppladdningen utan svar
        # i 20 s och två processer kvar).
        bounded_run(["notify-send", NOTIF_STRINGS[get_system_lang()]["clipboard"],
                     "--icon=edit-copy", "-a", "Sling"])
        log("urklipp från telefonen (%d tecken)" % len(text))
        self._send(200, b'{"ok": true}', "application/json")

    def do_POST(self):
        rest = self._resolve()
        if rest is None:
            self._no_token()
            return
        if rest == "/clip":
            self._receive_clip()
            return
        if rest != "/upload":
            self._send(404)
            return

        ctype = self.headers.get("Content-Type", "")
        try:
            length = int(self.headers.get("Content-Length", 0))
        except ValueError:
            length = 0
        if not ctype.startswith("multipart/form-data") or length == 0:
            self._send(400)
            return
        if length > MAX_UPLOAD:
            log("avvisade uppladdning på %d byte (tak %d)" % (length, MAX_UPLOAD))
            # Läs och släng kroppen (upp till 8 MB) INNAN svaret skickas: annars
            # får klienten en bruten anslutning mitt i sin egen uppladdning i
            # stället för beskedet. Sedan stängs anslutningen — resten av kroppen
            # skulle annars tolkas som nästa förfrågan.
            self.close_connection = True
            drain = min(length, 8 * 1024 * 1024)
            while drain > 0:
                chunk = self.rfile.read(min(65536, drain))
                if not chunk:
                    break
                drain -= len(chunk)
            self._send(413, json.dumps({"ok": False, "error": "too large"}).encode(), "application/json")
            return

        def track(nbytes, name=None):
            if name:
                ACTIVE["name"] = name
            bump_transfer(nbytes)

        start_transfer("up", "", length)
        try:
            saved = stream_multipart(self.rfile, ctype, length, RECEIVED_DIR, on_progress=track)
        except TimeoutError:
            # Läsdeadlinen slog till mitt i kroppen: klienten är borta, kasta
            # anslutningen (handle_one_request) i stället för att svara på den.
            raise
        except (OSError, ValueError) as exc:
            # ValueError: ett filnamn ur multipart-rubriken kan innehålla NUL, och open()
            # kastar då — utan det här hade anropet dött utan svar (se safe_upload_name).
            log("uppladdning misslyckades: %s" % exc)
            self._send(500, json.dumps({"ok": False, "error": str(exc)}).encode(), "application/json")
            return
        finally:
            end_transfer()

        if saved:
            key = "received_single" if len(saved) == 1 else "received_multi"
            summary = NOTIF_STRINGS[get_system_lang()][key].format(count=len(saved))
            # Bara antalet i notisen: filnamnen är privat metadata och låg förut i argv,
            # läsbar för varje lokal användare som ser processlistan. Körningen är
            # takad, som allt annat på en förfrågningsväg.
            bounded_run(["notify-send", summary, "--icon=folder-download", "-a", "Sling"])
            log("tog emot %d fil(er): %s" % (len(saved), ", ".join(saved[:3])))

        self._send(200, json.dumps({"ok": True, "saved": saved}).encode(), "application/json")


class SlingServer(ThreadingHTTPServer):
    """En tråd per anslutning — men antalet samtidiga anslutningar har ett tak.

    ThreadingMixIn startar en tråd per accepterad socket och token-grinden kommer
    först när förfrågan är läst, så utan tak är både trådar och fildeskriptorer
    obegränsade för en oautentiserad klient på LAN:et. Över taket svaras 503 och
    anslutningen stängs i stället för att köas.
    """
    daemon_threads = True
    request_queue_size = MAX_CONNECTIONS

    def __init__(self, *args, **kwargs):
        super().__init__(*args, **kwargs)
        self._slots = threading.BoundedSemaphore(MAX_CONNECTIONS)

    def process_request(self, request, client_address):
        if not self._slots.acquire(blocking=False):
            try:
                request.sendall(b"HTTP/1.1 503 Service Unavailable\r\n"
                                b"Content-Length: 0\r\nConnection: close\r\n\r\n")
            except OSError:
                pass
            self.shutdown_request(request)
            return
        try:
            super().process_request(request, client_address)
        except BaseException:
            self._slots.release()          # tråden startade aldrig
            raise

    def process_request_thread(self, request, client_address):
        try:
            super().process_request_thread(request, client_address)
        finally:
            self._slots.release()

    def server_bind(self):
        """Hoppar över BaseHTTPServer.server_bind, som gör en omvänd DNS-lookup
        (socket.getfqdn) innan socketen börjar lyssna. Mätt: 5,01 s på den här
        maskinen — och eftersom PID-filen skrevs först visade panelen "running"
        medan ingenting svarade."""
        import socketserver
        socketserver.TCPServer.server_bind(self)
        self.server_name = "sling"
        self.server_port = self.server_address[1]


# ------------------------------------------------------------------------------
# Status — en källa för CLI och HTTP
# ------------------------------------------------------------------------------
def status_dict(running=None):
    token = current_token() or read_token()
    ip = get_local_ip()
    if running is None:
        running = port_open()
    if running:
        generate_qr(server_url(token, ip))
    data = {
        "ok": True,
        "version": VERSION,
        "running": bool(running),
        "ip": ip,
        "port": PORT,
        "url": server_url(token, ip),
        "mdns_url": ("http://%s.local:%d/t/%s/" % (MDNS_NAME, PORT, token)) if MDNS_UP else "",
        "idle_timeout": IDLE_TIMEOUT,
        "max_upload": MAX_UPLOAD,
        "qr_path": QR_PATH,
        "qr_ok": os.path.exists(QR_PATH),
        "received_dir": RECEIVED_DIR,
        "send_dir": SEND_DIR,
        "recent_files": list_files(RECEIVED_DIR, 5),
        "send_files": list_files(SEND_DIR),
        "active": active_dict(),
    }
    # En pågående överföring finns bara i serverprocessens minne. CLI:t — och
    # därmed panelens poll — måste hämta den från serverns eget /status; annars
    # stod docken på "redo" medan en fil rullade (mätt).
    if running and not IS_SERVER:
        live = server_status(token)
        if live and "active" in live:
            data["active"] = live["active"]
    return data


def server_status(token):
    """Serverns egen /status, eller None om den inte svarar."""
    try:
        with urllib.request.urlopen("http://127.0.0.1:%d/t/%s/status" % (PORT, token), timeout=2) as r:
            return json.loads(r.read())
    except Exception:
        return None


# ------------------------------------------------------------------------------
# Kommandon
# ------------------------------------------------------------------------------
def cmd_server():
    """Startar servern. Porten tas INNAN något skrivs till tillståndskatalogen.

    Två samtidiga `start` (dubbelklick i panelen) skrev förut båda sin token, och
    den som förlorade kampen om porten dog på "Address already in use" — kvar stod
    panelens URL och QR med en token som den körande servern nekar (mätt: HTTP 403
    mot token i filen medan servern svarade), och förlorarens städning kunde radera
    den körandes pid-, token-, URL- och QR-filer. Binda först: den som inte får
    porten har inget att skriva över och lämnar ett begripligt felmeddelande.
    """
    global _TOKEN, IS_SERVER
    IS_SERVER = True
    _TOKEN = secrets.token_urlsafe(9)
    try:
        server = SlingServer(("0.0.0.0", PORT), SlingHandler)
    except OSError as exc:
        print("Sling: kan inte ta port %d (%s) — kör redan en server?" % (PORT, exc),
              file=sys.stderr)
        return 1

    url = server_url(_TOKEN)
    write_private(TOKEN_FILE, _TOKEN)      # token är hela gaten: 0600 från start
    write_private(PID_FILE, str(os.getpid()))   # 0600 vid skapandet, som tokenfilen
    mdns = start_mdns()
    global MDNS_UP
    MDNS_UP = bool(mdns)                   # panelen visar adressen bara om den publiceras
    threading.Thread(target=server.serve_forever, daemon=True).start()
    qr_ok = generate_qr(url)
    log("lyssnar på 0.0.0.0:%d, mDNS=%s, qr_ok=%s" % (PORT, bool(mdns), qr_ok))

    def bye(*_):
        raise SystemExit(0)

    signal.signal(signal.SIGTERM, bye)
    signal.signal(signal.SIGINT, bye)
    try:
        while (time.monotonic() - LAST_ACTIVITY["t"] <= IDLE_TIMEOUT
               # En pågående överföring är trafik även när ingen bit hunnit läsas
               # klart: läsetningen är girig (upp till 256 KiB), så en långsam klient
               # ger inga avbrott emellan. Mätt med taket satt till 2 s: en överföring
               # kapades efter 3,6 s. En klient som slutar skicka fastnar i
               # läsdeadlinen (SOCKET_TIMEOUT) och då nollas ACTIVE, så taket gäller
               # fortfarande för en död transfer.
               or ACTIVE["dir"]):
            time.sleep(2)
        log("ingen trafik på %ds — avväpnar" % IDLE_TIMEOUT)
    except (KeyboardInterrupt, SystemExit):
        pass
    finally:
        server.shutdown()
        server.server_close()
        if mdns:
            mdns.terminate()
        MDNS_UP = False
        # Städa bara det som fortfarande är vårt: har en annan server tagit över
        # tillståndskatalogen är filerna dess, och att radera dem vore att slå ut
        # en körande server.
        if filmnehall(TOKEN_FILE) == _TOKEN:
            for path in (PID_FILE, TOKEN_FILE, URL_FILE, QR_PATH):
                # URL-filen och QR-bilden bär samma token som tokenfilen; att städa
                # bara två av fyra lämnade en kopia av token kvar i katalogen.
                try:
                    os.remove(path)
                except OSError:
                    pass
    return 0


def cmd_start():
    if port_open():
        print("Sling is already running.")
        return 0
    with open(LOG_PATH, "a") as logfh:
        subprocess.Popen([sys.executable, os.path.abspath(__file__), "server"],
                         stdout=logfh, stderr=logfh, start_new_session=True)
    for _ in range(50):                     # upp till ~5 s
        token = read_token()
        # Tre saker måste stämma innan vi påstår att servern är uppe: porten lyssnar,
        # tokenfilen är skriven (servern tar porten först och skriver sedan), och
        # servern SVARAR på just den token. Annars kunde panelen visa en URL och QR
        # som den körande servern nekar — eller en tom token, om vi läste filen i
        # fönstret mellan bind och skrivning (mätt: två samtidiga `start` gav HTTP 403
        # mot token i filen). Ett främmande program på porten ger samma svar: inte uppe.
        if port_open() and token and server_status(token):
            print("Sling started: %s" % server_url(token))
            return 0
        time.sleep(0.1)
    print("Sling did not come up — se %s" % LOG_PATH, file=sys.stderr)
    return 1


def pid_is_our_server(pid):
    """True bara om piden kör DEN HÄR filen som `server`.

    Att ett namn finns någonstans i argv räcker inte: `rg server omarchy-sling` —
    eller en editor öppnad på de två filerna — har båda namnen i sin kommandorad.
    Mätt: en främmande process med ["server", "omarchy-sling"] i argv pekades ut som
    vår server och hade dödats av `stop`. Nu krävs formen <tolk> <den här filens
    sökväg> server: argv[1] måste vara samma fil som den här processen kör (efter
    realpath, så en symlinkad installation räknas) och argv[2] måste vara "server".
    En kopia av skriptet på en annan sökväg känns alltså inte igen — hellre att
    stoppa för lite än att signalera någon annans process.
    """
    if pid <= 1 or pid == os.getpid():
        return False
    try:
        with open("/proc/%d/cmdline" % pid, "rb") as fh:
            argv = [a for a in fh.read().decode("utf-8", "replace").split("\0") if a]
    except OSError:
        return False
    if len(argv) < 3 or argv[2] != "server":
        return False
    try:
        return os.path.realpath(argv[1]) == os.path.realpath(__file__)
    except OSError:
        return False


def server_pids():
    """Pidarna för våra egna serverprocesser, hittade genom att fråga /proc.

    Aldrig genom att matcha en sträng: `pkill -f "omarchy-sling server"` dödade en
    process vars kommandorad bara nämnde texten (mätt: ett skal med strängen i en
    kommentar — samma klass som fyndet om en pid ur en fil). Här prövas varje pid
    med pid_is_our_server först.
    """
    return [int(n) for n in os.listdir("/proc") if n.isdigit() and pid_is_our_server(int(n))]


def filmnehall(path):
    """Filens innehåll, utan radbrytning — eller None om den inte går att läsa."""
    try:
        with open(path) as fh:
            return fh.read().strip()
    except OSError:
        return None


def cmd_stop():
    pid = None
    try:
        with open(PID_FILE) as fh:
            pid = int(fh.read().strip())
    except (OSError, ValueError):
        pass
    stoppade = False
    if pid and pid_is_our_server(pid):
        try:
            os.kill(pid, signal.SIGTERM)
            stoppade = True
        except OSError:                 # försvann, eller inte vår att signalera
            pass
    # Fallback när pid-filen saknas eller pekar fel. Gaten är INTE "någon lyssnar på
    # porten" — det säger ingenting om att lyssnaren är vår (mätt: med en främmande
    # lyssnare på porten dödades ändå en process vars kommandorad råkade nämna våra
    # namn). Först ett svar med VÅR token: det kan bara vår server ge. Sedan
    # signaleras bara processer som kör den här filen som `server`.
    token = current_token() or read_token()
    if token and server_status(token) is not None:
        for annan in server_pids():
            try:
                os.kill(annan, signal.SIGTERM)
                stoppade = True
            except OSError:
                pass
    for _ in range(30):                 # upp till ~3 s på att porten stängs
        if not port_open():
            break
        time.sleep(0.1)
    if stoppade or not port_open():
        print("Sling stopped.")
    else:
        print("Nothing of Sling's is listening on port %d — nothing stopped." % PORT)
    return 0


def cmd_status():
    print(json.dumps(status_dict()))
    return 0


def cmd_open(which=None):
    subprocess.run(["xdg-open", SEND_DIR if which == "send" else RECEIVED_DIR], check=False)
    return 0


def cmd_copy(which=None):
    """Lägger serverns URL i urklipp — via stdin, aldrig argv (token!).

    Mätt 2026-10-08: Quickshells `Process` med `stdinEnabled` skickar texten men
    stänger inte stdin, och `wl-copy` läser till EOF — den kopierade ingenting.
    Pythons `input=` skickar och stänger, så kopieringen hamnar här i stället.
    """
    token = current_token() or read_token()
    if not token:
        print("ingen token — starta servern först", file=sys.stderr)
        return 1
    url = server_url(token) if which != "mdns" else "http://%s.local:%d/t/%s/" % (MDNS_NAME, PORT, token)
    if not shutil.which("wl-copy"):
        print("wl-copy saknas", file=sys.stderr)
        return 1
    # Takad körning, som allt annat som startar en process åt användaren: ett
    # hängande wl-copy (urklippstjänst som inte svarar) lämnade förut kommandot utan
    # återkomst och två processer kvar — mätt: ingen återkomst inom 15 s.
    bounded_run(["wl-copy"], data=url.encode())
    print(url)
    return 0


def cmd_send(paths):
    """Lägger filer i Send/. Symlänk i första hand — en 2 GB-video ska inte
    behöva finnas i två kopior för att kunna hämtas."""
    count = 0
    for raw in paths:
        src = os.path.abspath(os.path.expanduser(raw))
        if not os.path.isfile(src):
            print("hoppar över %s (ingen fil)" % src, file=sys.stderr)
            continue
        dest = os.path.join(SEND_DIR, os.path.basename(src))
        if os.path.islink(dest) and not os.path.exists(dest):
            # Källfilen är borta — länken är död och namnet ledigt igen.
            os.remove(dest)
        elif os.path.exists(dest) and os.path.samefile(dest, src):
            # Samma fil en gång till: kön har den redan, ingen _1-kopia.
            # (unique_path gjorde förut en ny länk varje gång man skickade om.)
            print("%s (already in send queue)" % dest)
            count += 1
            continue
        if os.path.exists(dest):
            dest = unique_path(SEND_DIR, os.path.basename(src))
        while True:
            try:
                os.symlink(src, dest)
                break
            except FileExistsError:
                # Namnet togs mellan kontrollen och länken — två samtidiga `send`
                # med samma basnamn från olika mappar. Det fallet gick förut vidare
                # till shutil.copy2, som FÖLJER en länk och skriver in i filen den
                # pekar på: mätt skrev 9 av 60 samtidiga par över en källfil, och
                # telefonen laddade sedan ner fel innehåll. Ta nästa lediga namn.
                dest = unique_path(SEND_DIR, os.path.basename(src))
            except OSError:
                # Filsystem utan länkar: kopiera — men aldrig över något som redan
                # ligger i kön, för en länk dit är en skrivning in i källfilen.
                if os.path.exists(dest):
                    dest = unique_path(SEND_DIR, os.path.basename(src))
                    continue
                shutil.copy2(src, dest)
                break
        print(dest)
        count += 1
    return 0 if count else 1


def cmd_remove(names):
    """Tar bort filer ur Send/-kön. Rör aldrig källfilen: kön består av länkar,
    och os.remove tar länken. Ett namn, inte en sökväg — basename hindrar '../'."""
    count = 0
    for raw in names:
        name = os.path.basename(raw)
        try:
            os.remove(os.path.join(SEND_DIR, name))
        except OSError:
            print("hittade inte %s i Send/" % name, file=sys.stderr)
            continue
        print("Removed from send queue: %s" % name)
        count += 1
    return 0 if count else 1


def cmd_clear():
    """Tömmer hela Send/-kön (länkarna, inte originalen)."""
    count = 0
    for item in os.listdir(SEND_DIR):
        try:
            os.remove(os.path.join(SEND_DIR, item))
            count += 1
        except OSError:
            pass
    print("Cleared %d file(s) from send queue." % count)
    return 0


def cmd_clip():
    """Delar PC:ns urklipp med telefonen (panelens knapp och `omarchy-sling clip`).

    wl-paste → sloten, aldrig via argv: ett urklipp kan vara ett lösenord, och
    argv är läsbar för varje lokal användare.
    """
    if not shutil.which("wl-paste"):
        print("wl-paste saknas (installera wl-clipboard)", file=sys.stderr)
        return 1
    rc, data = paste_bounded("wl-paste", "-n")
    if rc != 0:                                # wl-clipboard < 2.0 har ingen -n
        rc, data = paste_bounded("wl-paste")
        data = data.rstrip(b"\n")               # ...och lägger på en egen radbrytning
    if rc != 0 or not data:
        print("kunde inte läsa urklippet", file=sys.stderr)
        return 1
    write_clip(data)
    print("urklipp delat med telefonen (%d tecken)" % len(data))
    return 0


def cmd_send_pick():
    if not shutil.which("zenity"):
        print("zenity saknas — öppnar Send-mappen i stället", file=sys.stderr)
        subprocess.run(["xdg-open", SEND_DIR], check=False)
        return 1
    r = subprocess.run(["zenity", "--file-selection", "--multiple", "--separator=\n",
                        "--title=Sling: skicka till telefonen"],
                       capture_output=True, text=True)
    paths = [line for line in r.stdout.splitlines() if line.strip()]
    return cmd_send(paths) if paths else 1


# ------------------------------------------------------------------------------
# Egenkontroll: parsern, token-grinden, taket
# ------------------------------------------------------------------------------
def cmd_selftest():
    """Kör en server på egen port i en städad miljö och verifierar att filer kommer
    fram byte-identiska, att saknad/fel token nekas och att storlekstaket håller."""
    import tempfile
    import urllib.error
    import urllib.request

    tmp = tempfile.mkdtemp(prefix="sling-selftest-")
    port = int(os.environ.get("SLING_SELFTEST_PORT", "5381"))

    # Skalenliga wl-copy/notify-send: proven ska varken röra användarens urklipp
    # eller poppa notiser på skärmen, och argv loggas så att innehållet kan
    # letas efter där (det får inte hamna där).
    shim = os.path.join(tmp, "shim")
    os.makedirs(shim, exist_ok=True)
    clip_out = os.path.join(tmp, "clip-stdin.txt")
    clip_argv = os.path.join(tmp, "clip-argv.txt")
    notif_log = os.path.join(tmp, "notify-argv.txt")
    clip_slot = os.path.join(tmp, ".clipboard")
    for name, body in (("wl-copy", 'printf "%%s\\n" "$*" >> "%s"\ncat > "%s"\n' % (clip_argv, clip_out)),
                       ("notify-send", 'printf "%%s\\n" "$*" >> "%s"\n' % notif_log),
                       # En avahi-publish-service som misslyckas direkt: provet ska se
                       # vad panelen visar när ingenting publiceras, och selftesten ska
                       # inte annonsera "sling" på Alex nät.
                       ("avahi-publish-service", "exit 1\n")):
        with open(os.path.join(shim, name), "w") as fh:
            fh.write("#!/bin/sh\n" + body)
        os.chmod(os.path.join(shim, name), 0o755)

    os.makedirs(os.path.join(tmp, "sling"), exist_ok=True)
    os.chmod(os.path.join(tmp, "sling"), 0o755)     # som en katalog skapad av en äldre version

    env = dict(os.environ,
               PATH=shim + ":" + os.environ.get("PATH", ""),
               SLING_PORT=str(port),
               SLING_BASE_DIR=tmp,
               SLING_IDLE_TIMEOUT="60",
               SLING_MAX_UPLOAD="2097152",            # 2 MB i provet
               SLING_MAX_CONNECTIONS="16",            # taket prövas nedan (12 samtidiga i kapplöpningsprovet)
               SLING_SOCKET_TIMEOUT="3",
               SLING_CLIP_TIMEOUT="1.5",              # provet för en hängande wl-copy
               XDG_RUNTIME_DIR=tmp,
               XDG_STATE_HOME=tmp,
               SLING_MDNS_NAME="sling-test")
    proc = subprocess.Popen([sys.executable, os.path.abspath(__file__), "server"],
                            env=env, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    failures = []
    counted = {"n": 0}

    def check(name, cond, detail=""):
        counted["n"] += 1
        print("  %-50s %s%s" % (name, "OK" if cond else "MISSLYCKADES", ("  " + detail) if detail else ""))
        if not cond:
            failures.append(name)

    def multipart(files):
        b = "----slingtest"
        out = b""
        for name, data in files:
            out += ("--%s\r\nContent-Disposition: form-data; name=\"files\"; filename=\"%s\"\r\n"
                    "Content-Type: application/octet-stream\r\n\r\n" % (b, name)).encode() + data + b"\r\n"
        return out + ("--%s--\r\n" % b).encode(), "multipart/form-data; boundary=" + b

    def post(files, token):
        body, ctype = multipart(files)
        req = urllib.request.Request("http://127.0.0.1:%d/t/%s/upload" % (port, token), data=body,
                                     headers={"Content-Type": ctype}, method="POST")
        try:
            with urllib.request.urlopen(req, timeout=30) as r:
                return r.status, json.loads(r.read())
        except urllib.error.HTTPError as e:
            return e.code, {}

    try:
        for _ in range(80):
            try:
                urllib.request.urlopen("http://127.0.0.1:%d/" % port, timeout=1)
                break
            except urllib.error.HTTPError:
                break
            except Exception:
                time.sleep(0.1)

        token_path = os.path.join(tmp, "sling", "token")
        with open(token_path) as fh:
            token = fh.read().strip()

        # HANCORE (2026-10-10): en fil skapad med open() är läsbar för andra lokala konton
        # innan chmod hinner sätta 0600. Allt hemlighetsbärande skrivs därför med mode vid
        # skapandet, och katalogerna tvingas till 0700 varje start.
        check("tokenfilen skrivs med 0600 (inget fönster)", stat.S_IMODE(os.stat(token_path).st_mode) == 0o600,
              oct(stat.S_IMODE(os.stat(token_path).st_mode))[-3:])
        _ddir = os.path.join(tmp, "sling")
        check("tillståndskatalogen tvingas till 0700", stat.S_IMODE(os.stat(_ddir).st_mode) == 0o700,
              oct(stat.S_IMODE(os.stat(_ddir).st_mode))[-3:])
        _logg = os.path.join(_ddir, "server.log")
        _mode = stat.S_IMODE(os.stat(_logg).st_mode)
        check("loggfilen skapas med 0600 (inget fönster)", _mode == 0o600, oct(_mode)[-3:])

        # Tillståndet får inte hamna i /tmp när XDG_RUNTIME_DIR saknas: där kan vem som
        # helst skapa katalogen först och läsa token ur den. Och en katalog som någon
        # annan håller i ska vi vägra skriva i, inte skriva i ändå.
        _utan = {k: v for k, v in os.environ.items() if k != "XDG_RUNTIME_DIR"}
        _utan["XDG_STATE_HOME"] = os.path.join(tmp, "statefall")
        _kod = ("import importlib.machinery as m, importlib.util as u, sys\n"
                "l = m.SourceFileLoader('sling', sys.argv[1])\n"
                "s = u.module_from_spec(u.spec_from_loader('sling', l))\n"
                "l.exec_module(s)\n"
                "print(s.STATE_DIR)\n")
        _r = subprocess.run([sys.executable, "-c", _kod, os.path.abspath(__file__)],
                            env=_utan, capture_output=True, text=True, timeout=30)
        _fall = _r.stdout.strip()
        check("utan XDG_RUNTIME_DIR hamnar tillståndet inte i /tmp",
              _r.returncode == 0 and _fall and not _fall.startswith("/tmp") and os.path.isabs(_fall), _fall or _r.stderr[-80:])

        _fientlig = os.path.join(tmp, "fientlig")
        os.makedirs(os.path.join(_fientlig, "run"), exist_ok=True)
        os.symlink(os.path.join(tmp, "Received"), os.path.join(_fientlig, "run", "sling"))
        _r2 = subprocess.run([sys.executable, os.path.abspath(__file__), "status"],
                             env=dict(os.environ, SLING_BASE_DIR=_fientlig,
                                      XDG_RUNTIME_DIR=os.path.join(_fientlig, "run"),
                                      XDG_STATE_HOME=os.path.join(_fientlig, "state")),
                             capture_output=True, text=True, timeout=30)
        check("vägrar skriva tillstånd i en symlinkad katalog",
              _r2.returncode != 0 and "symlink" in (_r2.stderr + _r2.stdout).lower(),
              "%s: %s" % (_r2.returncode, (_r2.stderr + _r2.stdout).strip().splitlines()[-1:]))

        # En pid ur en fil är inget att lita på: bara vår egen server får signaleras.
        _fras = subprocess.Popen(["sleep", "30"])
        try:
            check("främmande pid nekas (även oss själva och pid 1)",
                  not pid_is_our_server(_fras.pid) and not pid_is_our_server(os.getpid())
                  and not pid_is_our_server(1) and _fras.poll() is None)
            check("vår egen server känns igen", pid_is_our_server(proc.pid), "pid %d" % proc.pid)
        finally:
            _fras.terminate()
            _fras.wait(timeout=10)

        payloads = [
            ("tom.bin", b""),
            ("liten.bin", bytes(range(256)) * 400),                       # 100 kB
            ("stor.bin", os.urandom(900_000)),                            # 900 kB, många buffertvarv
        ]
        code, reply = post(payloads, token)
        check("uppladdning svarar 200", code == 200, "fick %s" % code)
        check("tre filer rapporterade", len(reply.get("saved", [])) == 3, "fick %s" % reply.get("saved"))
        for name, data in payloads:
            path = os.path.join(tmp, "Received", name)
            ok = os.path.isfile(path) and open(path, "rb").read() == data
            check("byte-identisk: %s (%d B)" % (name, len(data)), ok)
            if not ok:
                break

        # En fil med NUL i namnet fick open() att kasta ValueError (do_POST fångade bara
        # OSError): anropet dog utan svar och filerna efter den i samma POST försvann.
        code, reply = post([("forst.bin", b"A"), ("nu\0ll.bin", b"B"), ("sist.bin", b"C")], token)
        _sav = reply.get("saved", [])
        check("filnamn med NUL-tecken hoppas över, resten kommer fram",
              code == 200 and _sav == ["forst.bin", "sist.bin"], "%s: %s" % (code, _sav))
        check("  ... och ingen fil med NUL i namnet skapades",
              not [f for f in os.listdir(os.path.join(tmp, "Received")) if "ll.bin" in f])

        code, reply = post([("..", b"X")], token)
        check("filnamnet '..' blir ingen fil", code == 200 and reply.get("saved") == [],
              "%s: %s" % (code, reply.get("saved")))

        # En kropp som innehåller själva gränssträngen går inte att representera i
        # multipart (avsändaren ska välja en gräns som inte förekommer i innehållet).
        # Det som måste hålla är att parsern inte tappar bort de följande delarna.
        fake = b"\r\n----slingtest\r\n" * 5000
        real = os.urandom(200_000)
        code, reply = post([("gräns.bin", fake), ("efter.bin", real)], token)
        check("del efter gräns-kropp kommer fram", os.path.isfile(os.path.join(tmp, "Received", "efter.bin")),
              "fick %s" % reply.get("saved"))
        efter = os.path.join(tmp, "Received", "efter.bin")
        check("  ... och är byte-identisk", os.path.isfile(efter) and open(efter, "rb").read() == real)
        gran = os.path.join(tmp, "Received", "gräns.bin")
        check("  gräns-kroppen är en trunkerad prefix",
              os.path.isfile(gran) and fake.startswith(open(gran, "rb").read()))

        code, reply = post([("liten.bin", b"x")], token)
        check("dubblettnamn får _1", "liten_1.bin" in reply.get("saved", []), "fick %s" % reply.get("saved"))

        code, _ = post([("tak.bin", b"y" * (3 * 1024 * 1024))], token)
        check("för stor uppladdning nekas (413)", code == 413, "fick %s" % code)
        check("ingen dellfil av den nekade finns", not os.path.exists(os.path.join(tmp, "Received", "tak.bin")))

        code, _ = post([("x.bin", b"z")], "fel-token")
        check("fel token nekas (403)", code == 403, "fick %s" % code)
        try:
            urllib.request.urlopen("http://127.0.0.1:%d/" % port, timeout=5)
            check("utan token nekas (403)", False, "släpptes igenom")
        except urllib.error.HTTPError as e:
            check("utan token nekas (403)", e.code == 403, "fick %s" % e.code)

        with urllib.request.urlopen("http://127.0.0.1:%d/t/%s/" % (port, token), timeout=5) as r:
            page = r.read().decode()
        check("mobilsidan renderas (200)", "Sling" in page)

        with urllib.request.urlopen("http://127.0.0.1:%d/t/%s/status" % (port, token), timeout=5) as r:
            st = json.loads(r.read())
        check("status har running/url/qr_ok", all(k in st for k in ("running", "url", "qr_ok")))
        check("status-url bär token", token in st["url"], st["url"])
        # Adressen att minnas visas bara när något publicerar den. Med en
        # avahi-publish-service som misslyckas direkt (skalet ovan) publiceras
        # ingenting — då får panelen inte visa http://sling.local.
        check("mDNS-adressen visas bara när den publiceras", st["mdns_url"] == "", repr(st["mdns_url"]))

        # En server som dödats hårt lämnar sin avahi-publicerare kvar, och då är
        # namnet upptaget av en adress som ingen lyssnar på. Mätt: en kvarglömd
        # `avahi-publish-service -s sling _http._tcp 5399` levde vidare efter
        # kill -9. start_mdns tar tillbaka namnet först.
        gammalt_mdnsnamn = globals()["MDNS_NAME"]
        globals()["MDNS_NAME"] = "sling-selftest-stale"
        try:
            sken_pub = os.path.join(tmp, "avahi-publish-service")
            with open(sken_pub, "w") as fh:
                # Ingen exec: kommandoraden ska behålla skriptnamnet, och när
                # skalet får SIGTERM ska inget långlivat barn bli kvar.
                fh.write("#!/bin/sh\nwhile :; do sleep 1; done\n")
            os.chmod(sken_pub, 0o755)
            kvarglömd = subprocess.Popen([sken_pub, "-s", globals()["MDNS_NAME"], "_http._tcp", "9"])
            time.sleep(0.4)
            check("kvarglömd publicerare av vårt namn pekas ut",
                  kvarglömd.pid in stale_publishers(), "%s i %s" % (kvarglömd.pid, stale_publishers()))
            # ... men en främmande process som bara NÄMNER namnen är ingen publicerare:
            # HANCORE, ärende 10821 — matchen såg namnen var som helst i argv, så en
            # editor öppnad på de filerna, eller en sökning, dödades av start_mdns.
            # Formen räknas nu: argv[0] ska vara avahi-publish-service och
            # argv[1:3] exakt ["-s", tjänstenamnet].
            namnbärare = subprocess.Popen([sys.executable, "-c", "import time; time.sleep(300)",
                                           "avahi-publish-service", globals()["MDNS_NAME"]])
            time.sleep(0.4)
            check("främmande process med publicerarens namn i argv pekas inte ut",
                  namnbärare.pid not in stale_publishers(), "pid %d" % namnbärare.pid)
            namnbärare.kill()
            # start_mdns() här i provprocessen får inte röra nätet: PATH riktas om
            # till ett skal som misslyckas direkt, så ingen riktig avahi-publicerare
            # startas (en kvarglömd sådan är hela poängen med provet).
            gammal_path = os.environ.get("PATH", "")
            tomt_skal = os.path.join(tmp, "tomt-skal")
            os.makedirs(tomt_skal, exist_ok=True)
            with open(os.path.join(tomt_skal, "avahi-publish-service"), "w") as fh:
                fh.write("#!/bin/sh\nexit 1\n")
            os.chmod(os.path.join(tomt_skal, "avahi-publish-service"), 0o755)
            os.environ["PATH"] = tomt_skal
            try:
                start_mdns()                   # ska städa den och sedan ge upp
            finally:
                os.environ["PATH"] = gammal_path
            kvar_pub = True
            for _ in range(20):
                kvar_pub = kvarglömd.poll() is None
                if not kvar_pub:
                    break
                time.sleep(0.1)
            check("  ... och start_mdns tar tillbaka namnet", not kvar_pub, "pid %d lever" % kvarglömd.pid)
            if kvar_pub:
                kvarglömd.kill()
        finally:
            globals()["MDNS_NAME"] = gammalt_mdnsnamn
        check("QR-koden skapas (qrencode via stdin)", st["qr_ok"] is True)
        check("status har active-nyckeln (None när inget pågår)", st.get("active") is None, str(st.get("active")))

        # Send-kön: dubblettskydd, borttagning, tömning. CLI:t i den här processen
        # pekar på riktiga ~/Downloads/Sling, så SEND_DIR riktas om under provet.
        saved_send_dir = SEND_DIR
        globals()["SEND_DIR"] = test_send = os.path.join(tmp, "Send")
        try:
            doc1 = os.path.join(tmp, "fil1.txt")
            with open(doc1, "w") as fh:
                fh.write("sling test data 1")
            cmd_send([doc1])
            check("send köar filen", os.path.exists(os.path.join(test_send, "fil1.txt")))

            cmd_send([doc1])
            check("samma fil igen ger ingen _1-kopia", not os.path.exists(os.path.join(test_send, "fil1_1.txt")))

            other = os.path.join(tmp, "annanstans")
            os.makedirs(other, exist_ok=True)
            doc2 = os.path.join(other, "fil1.txt")
            with open(doc2, "w") as fh:
                fh.write("annat innehåll")
            cmd_send([doc2])
            check("annan fil med samma namn får _1", os.path.exists(os.path.join(test_send, "fil1_1.txt")))

            # Kapplöpningen i kön: namnet tas av en annan samtidig `send` mellan
            # kontrollen och länken. Det fallet gick förut vidare till shutil.copy2,
            # som FÖLJER en länk och skriver in i filen den pekar på — mätt skrev 9 av
            # 60 samtidiga par med samma basnamn över en källfil, och telefonen laddade
            # sedan ner fel innehåll. Här tvingas exakt det ögonblicket fram: länken
            # finns redan när cmd_send försöker skapa den.
            offer = os.path.join(other, "kollision.txt")
            with open(offer, "w") as fh:
                fh.write("ORIGINAL")
            inkorg = os.path.join(tmp, "inkommande")
            os.makedirs(inkorg, exist_ok=True)
            inkommande = os.path.join(inkorg, "kollision.txt")
            with open(inkommande, "w") as fh:
                fh.write("INKOMMANDE")
            riktig_symlink = os.symlink
            första = []

            def falsk_symlink(src, dst, **kw):
                if not första:                     # bara första försöket kolliderar
                    första.append(dst)
                    riktig_symlink(inkommande, dst)
                    raise FileExistsError(17, "File exists")
                return riktig_symlink(src, dst, **kw)

            os.symlink = falsk_symlink
            try:
                cmd_send([offer])
            finally:
                os.symlink = riktig_symlink
            with open(offer) as fh:
                kvar_offer = fh.read()
            with open(inkommande) as fh:
                kvar_inkommande = fh.read()
            kön = sorted(f for f in os.listdir(test_send) if f.startswith("kollision"))
            check("namnkollision i kön skriver inte in i en källfil",
                  kvar_offer == "ORIGINAL" and kvar_inkommande == "INKOMMANDE" and len(kön) == 2,
                  "%r/%r, kön: %s" % (kvar_offer, kvar_inkommande, kön))

            doc3 = os.path.join(tmp, "dod.txt")
            with open(doc3, "w") as fh:
                fh.write("x")
            cmd_send([doc3])
            os.remove(doc3)
            doc3b = os.path.join(other, "dod.txt")
            with open(doc3b, "w") as fh:
                fh.write("y")
            cmd_send([doc3b])
            check("död länk ger plats åt namnet igen",
                  os.path.realpath(os.path.join(test_send, "dod.txt")) == os.path.realpath(doc3b))

            cmd_remove(["fil1.txt"])
            check("remove tar bort ur kön", not os.path.exists(os.path.join(test_send, "fil1.txt")))
            check("... men rör inte källfilen", os.path.exists(doc1))

            cmd_clear()
            check("clear tömmer kön", os.listdir(test_send) == [])
            check("... utan att röra originalen", os.path.exists(doc1) and os.path.exists(doc2))
        finally:
            globals()["SEND_DIR"] = saved_send_dir

        # Resurstak: en tyst, oautentiserad klient får inte kunna hålla hur många
        # trådar och fildeskriptorer som helst. Provet öppnar fler anslutningar än
        # taket och skickar inte en enda byte i någon av dem.
        limit = int(env["SLING_MAX_CONNECTIONS"])
        deadline = int(env["SLING_SOCKET_TIMEOUT"])
        silent = []
        try:
            for _ in range(limit + 4):
                silent.append(socket.create_connection(("127.0.0.1", port), timeout=5))
            # Räknas medan de tysta anslutningarna ligger kvar: det är här ett
            # obegränsat tak syns (före åtgärden: 202 trådar och 204 fds på 200).
            threads = len(os.listdir("/proc/%d/task" % proc.pid))
            check("trådarna hålls under taket", threads <= limit + 3, "%d trådar (tak %d)" % (threads, limit))
            fds = len(os.listdir("/proc/%d/fd" % proc.pid))
            check("fildeskriptorerna hålls under taket", fds <= limit + 8, "%d fds" % fds)

            refused = 0
            for s in silent:
                s.settimeout(1)
                try:
                    first = s.recv(64)
                except TimeoutError:
                    continue                     # hålls öppen — tyst klient, inom taket
                except OSError:
                    refused += 1                 # servern stängde den
                    continue
                if first.startswith(b"HTTP/1.1 503") or first == b"":
                    refused += 1
            check("taket avvisar anslutningar över taket", refused >= 4, "%d av %d" % (refused, len(silent)))
        finally:
            for s in silent:
                s.close()
        time.sleep(1)

        with urllib.request.urlopen("http://127.0.0.1:%d/t/%s/status" % (port, token), timeout=5) as r:
            check("servern svarar igen efter överbelastningen", json.loads(r.read()).get("ok") is True)

        # En klient som tiger släpps av läsdeadlinen i stället för att hålla kvar.
        t0 = time.monotonic()
        quiet = socket.create_connection(("127.0.0.1", port), timeout=deadline + 5)
        try:
            released = quiet.recv(64) == b""
        except OSError:
            released = True                      # återställd räknas också som släppt
        finally:
            quiet.close()
        took = time.monotonic() - t0
        check("tyst klient släpps av läsdeadlinen", released and took < deadline + 4, "%.1f s" % took)

        # Urklipp: PC → telefon via sloten (skriven av CLI:t), telefon → PC via
        # wl-copy på stdin. Innehållet får aldrig hamna i argv — ett urklipp kan
        # vara ett lösenord.
        saved_clip_path = globals()["CLIP_PATH"]
        globals()["CLIP_PATH"] = clip_slot
        real_paste = globals()["paste_bounded"]

        # Skenbar klippkälla: proven ska varken röra användarens urklipp eller läsa
        # från den riktiga wl-paste (den kan hänga på en ägare som inte svarar).
        globals()["paste_bounded"] = lambda *cmd: (0, "delat urklipp ✓".encode())
        try:
            try:
                rc_clip = cmd_clip()
            finally:
                globals()["paste_bounded"] = real_paste
        finally:
            globals()["CLIP_PATH"] = saved_clip_path

        # Taket ska gälla LÄSNINGEN, inte bara det som skrivs: en källa som strömmar utan
        # slut får inte fylla minnet, och en som slutar skriva utan att stänga får inte
        # hänga kommandot (HANCORE, ärende 10821).
        t0 = time.monotonic()
        _, strommande = real_paste("yes")
        tog = time.monotonic() - t0
        check("strömmande klippkälla klipps vid taket", len(strommande) == CLIP_MAX and tog < 6,
              "%d B på %.1f s" % (len(strommande), tog))
        sparad_timeout = globals()["CLIP_TIMEOUT"]
        globals()["CLIP_TIMEOUT"] = 1.5
        try:
            t0 = time.monotonic()
            _, tyst = real_paste("sleep", "30")
            tog = time.monotonic() - t0
        finally:
            globals()["CLIP_TIMEOUT"] = sparad_timeout
        check("tyst klippkälla släpps av tidsgränsen", tyst == b"" and tog < 4, "%.1f s" % tog)

        # ... och samma sak när källan har ett BARN som håller vårt stdout-rör: wl-paste
        # fork+exec:ar ett eget `cat`-barn, och att döda bara föräldern lämnade röret
        # öppet — läsningen stod kvar för evigt och barnet blev kvar som process
        # (HANCORE, ärende 10821). Källan härmas av ett skal som startar ett barn vilket
        # ärver stdout och sedan väntar självt; båda sina pidar skriver det till en fil,
        # så provet kan se exakt de processerna i stället för att leta i /proc efter
        # namn. Läsningen körs i en tråd, så att en kvarhängande läsning syns som ett
        # underkänt prov i stället för att hänga hela selftesten.
        pidfil = os.path.join(tmp, "klippkalla.pid")
        kalla = os.path.join(tmp, "klippkalla")
        with open(kalla, "w") as fh:
            fh.write("#!/bin/sh\nsleep 4321 &\necho \"$$ $!\" > '%s'\nexec sleep 4321\n" % pidfil)
        os.chmod(kalla, 0o755)

        def lever(pid):
            try:
                with open("/proc/%s/stat" % pid) as fh:
                    return fh.read().split()[2] != "Z"       # Z = skördad, alltså borta
            except OSError:
                return False

        svar_barn = {}
        globals()["CLIP_TIMEOUT"] = 1.5
        try:
            tr = threading.Thread(target=lambda: svar_barn.update(svar=real_paste(kalla)), daemon=True)
            t0 = time.monotonic()
            tr.start()
            tr.join(6)
            tog = time.monotonic() - t0
        finally:
            globals()["CLIP_TIMEOUT"] = sparad_timeout
        try:
            with open(pidfil) as fh:
                pidar = [int(p) for p in fh.read().split()]
        except (OSError, ValueError):
            pidar = []
        # Döm först, städa sedan: en process som dödats blir skördad strax efteråt, så
        # domen väntar en stund på att den försvinner.
        kvar = []
        for _ in range(20):
            kvar = [p for p in pidar if lever(p)]
            if not kvar:
                break
            time.sleep(0.1)
        check("källa vars barn håller stdout-röret släpps",
              not tr.is_alive() and svar_barn.get("svar", (1, b""))[1] == b"" and tog < 4,
              "%.1f s" % tog)
        check("... och barnet blir inte kvar som process",
              len(pidar) == 2 and not kvar, "%d pidar, kvar: %s" % (len(pidar), kvar))
        for p in kvar:                                      # städa efter ett underkänt prov
            try:
                os.kill(p, signal.SIGKILL)
            except OSError:
                pass
        check("urklippsloten skrivs med 0600", stat.S_IMODE(os.stat(clip_slot).st_mode) == 0o600,
              oct(stat.S_IMODE(os.stat(clip_slot).st_mode))[-3:])
        with open(clip_slot) as fh:
            shared = fh.read()
        check("urklippet från PC:n hamnar i sloten", rc_clip == 0 and shared == "delat urklipp ✓",
              "%d tecken" % len(shared))

        with urllib.request.urlopen("http://127.0.0.1:%d/t/%s/clip" % (port, token), timeout=5) as r:
            served = r.read().decode()
        check("telefonen hämtar sloten via /clip", served == shared, repr(served[:24]))

        # HANCORE:s tredje fynd: en process som öppnade sloten under det gamla läsbara
        # fönstret får inte kunna läsa framtida urklipp. Det håller bara om varje
        # skrivning sker till en NY inode — att skriva om filen (O_TRUNC) lämnar kvar
        # den gamla läsarens åtkomst. Provet öppnar sloten, skriver igen och ser att
        # den gamla beskrivningen inte följer med.
        sparad_slot = globals()["CLIP_PATH"]
        globals()["CLIP_PATH"] = clip_slot
        try:
            with open(clip_slot, "rb") as gammal_lasare:
                inode_fore = os.stat(clip_slot).st_ino
                nytt_urklipp = "nytt urklipp på ny inode ✓".encode()
                write_clip(nytt_urklipp)
                inode_efter = os.stat(clip_slot).st_ino
                check("ny skrivning ger ny inode (gammal läsare tappar åtkomsten)",
                      inode_efter != inode_fore, "%d -> %d" % (inode_fore, inode_efter))
                check("... och den gamla läsaren ser inte det nya urklippet",
                      gammal_lasare.read() != nytt_urklipp)
                with open(clip_slot, "rb") as fh:
                    check("... men sloten bär det nya urklippet", fh.read() == nytt_urklipp)
        finally:
            globals()["CLIP_PATH"] = sparad_slot

        clip_text = "text från telefonen ✓".encode()
        req = urllib.request.Request("http://127.0.0.1:%d/t/%s/clip" % (port, token), data=clip_text,
                                     headers={"Content-Type": "text/plain; charset=utf-8"}, method="POST")
        with urllib.request.urlopen(req, timeout=5) as r:
            clip_resp = json.loads(r.read())
        with open(clip_out, "rb") as fh:
            on_stdin = fh.read()
        check("urklipp från telefonen går till wl-copy", clip_resp.get("ok") is True and on_stdin == clip_text,
              repr(on_stdin[:24]))

        with open(clip_argv) as fh:
            argv_log = fh.read()
        with open(notif_log) as fh:
            notif = fh.read()
        check("... och innehållet står varken i argv eller i notisen",
              "text från telefonen" not in argv_log and "text från telefonen" not in notif,
              notif.strip()[:48])

        big = b"x" * (CLIP_MAX + 1)
        req = urllib.request.Request("http://127.0.0.1:%d/t/%s/clip" % (port, token), data=big,
                                     headers={"Content-Type": "text/plain; charset=utf-8"}, method="POST")
        try:
            with urllib.request.urlopen(req, timeout=5) as r:
                code = r.status
        except urllib.error.HTTPError as exc:
            code = exc.code
        check("för stort urklipp avvisas (413)", code == 413, str(code))

        # Token får aldrig hamna i en process kommandorad (argv) — en annan lokal
        # användare kan läsa den ur processlistan. Provet fångar arg-versionen av
        # generate_qr genom att spionera på subprocess.run, med QR- och URL-filerna
        # omdirigerade till provets egen katalog så inget rörs i skarp drift.
        saved_paths = (globals()["QR_PATH"], globals()["URL_FILE"])
        globals()["QR_PATH"] = os.path.join(tmp, "qr-test.png")
        globals()["URL_FILE"] = os.path.join(tmp, "url-test")
        seen = {"cmd": [], "data": None}
        real_bounded = globals()["bounded_run"]

        def spy(cmd, data=None, limit=None, timeout=None):
            seen["cmd"] = list(cmd)
            seen["data"] = data
            return 0, b"\x89PNG\r\n\x1a\n" + b"prov" * 40      # skenbar PNG ur skenbar qrencode

        try:
            globals()["bounded_run"] = spy
            try:
                qr_ok = generate_qr("http://10.0.0.9:5380/t/HEMLIG-TOKEN/")
            finally:
                globals()["bounded_run"] = real_bounded
        finally:
            globals()["QR_PATH"], globals()["URL_FILE"] = saved_paths
        joined = " ".join(seen["cmd"])
        check("QR skapas utan token i argv", qr_ok and "HEMLIG-TOKEN" not in joined,
              "argv: " + joined)
        check("  ... URL:en går på stdin", seen["data"] == b"http://10.0.0.9:5380/t/HEMLIG-TOKEN/",
              repr(seen["data"]))
        check("  ... och QR-filen skrivs 0600 av oss, inte av qrencode",
              stat.S_IMODE(os.stat(os.path.join(tmp, "qr-test.png")).st_mode) == 0o600,
              oct(stat.S_IMODE(os.stat(os.path.join(tmp, "qr-test.png")).st_mode))[-3:])

        # Samma skydd för kopieringen: wl-copy ska få URL:en på stdin, aldrig i argv.
        # (Kopieringen går genom bounded_run, som QR-koden — därför spioneras den.)
        saved_token_file = globals()["TOKEN_FILE"]
        globals()["TOKEN_FILE"] = os.path.join(tmp, "sling", "token")
        globals()["_TOKEN"] = ""
        seen_copy = {"cmd": [], "data": None}
        real_bounded_copy = globals()["bounded_run"]

        def spy_copy(cmd, data=None, limit=None, timeout=None):
            seen_copy["cmd"] = list(cmd)
            seen_copy["data"] = data
            return 0, b""

        try:
            globals()["bounded_run"] = spy_copy
            try:
                rc = cmd_copy()
            finally:
                globals()["bounded_run"] = real_bounded_copy
        finally:
            globals()["TOKEN_FILE"] = saved_token_file
            globals()["_TOKEN"] = ""
        joined_copy = " ".join(seen_copy["cmd"])
        check("kopieringen går via stdin, inte argv",
              rc == 0 and joined_copy == "wl-copy" and token not in joined_copy, "argv: " + joined_copy)
        check("  ... och bär hela token-URL:en",
              (seen_copy["data"] or b"").decode().endswith("/t/%s/" % token),
              "%d byte på stdin" % len(seen_copy["data"] or b""))

        # Förloppsindikatorn mäts mitt i en överföring. Kroppen skickas i bitar med
        # paus, så servern står kvar i läsningen och 'active' går att se — till
        # skillnad från att hoppas att en nedladdning inte hinner klart i bufferten.
        class SlowBody:
            def __init__(self, data, chunk=65536, delay=0.08):
                self.data, self.pos, self.chunk, self.delay = data, 0, chunk, delay

            def read(self, n=None):
                time.sleep(self.delay)
                piece = self.data[self.pos:self.pos + self.chunk]
                self.pos += len(piece)
                return piece

        # Under provets eget tak (2 MB) — annars svarar servern 413 och provet mäter inget.
        payload = os.urandom(1_500_000)
        body, ctype = multipart([("stor3.bin", payload)])
        req = urllib.request.Request("http://127.0.0.1:%d/t/%s/upload" % (port, token), data=SlowBody(body),
                                     headers={"Content-Type": ctype, "Content-Length": str(len(body))}, method="POST")

        mid = {}
        done = threading.Event()

        def slow_post():
            try:
                with urllib.request.urlopen(req, timeout=60) as r:
                    mid["status"] = r.status
                    mid["saved"] = json.loads(r.read()).get("saved")
            except Exception as exc:                        # noqa: BLE001 — provet rapporterar själv
                mid["fel"] = repr(exc)
            done.set()

        threading.Thread(target=slow_post, daemon=True).start()
        seen = None
        deadline = time.time() + 20
        while time.time() < deadline and not done.is_set():
            with urllib.request.urlopen("http://127.0.0.1:%d/t/%s/status" % (port, token), timeout=5) as r:
                a = json.loads(r.read()).get("active")
            if a and a.get("dir") == "up" and a.get("done", 0) > 0:
                seen = a
                break
            time.sleep(0.1)
        check("pågående uppladdning syns i status", seen is not None,
              ("%s %d%% %s/%s" % (seen["name"], seen["pct"], seen["human_done"], seen["human_total"])) if seen else "sågs aldrig")
        check("  ... med filnamn, total och progress", bool(seen) and seen["name"] == "stor3.bin"
              and seen["total"] == len(body) and 0 < seen["pct"] < 100, str(seen and seen.get("pct")))
        check("  ... och en fart i byte/s", bool(seen) and seen["speed"] > 0, str(seen and round(seen.get("speed", 0))))

        # Varje läst bit ska räknas som aktivitet: avväpningstimern tittar bara på
        # LAST_ACTIVITY, så utan det stod klockan still under en överföring.
        före_aktivitet = LAST_ACTIVITY["t"]
        time.sleep(0.05)
        bump_transfer(1)
        check("varje överförd bit räknas som aktivitet", LAST_ACTIVITY["t"] > före_aktivitet,
              "%.3f -> %.3f" % (före_aktivitet, LAST_ACTIVITY["t"]))

        # Panelens egen väg: `omarchy-sling status` (CLI) måste visa samma pågående
        # överföring — den finns bara i serverprocessens minne och läses ur /status.
        cli = subprocess.run([sys.executable, os.path.abspath(__file__), "status"],
                             env=env, capture_output=True, text=True, timeout=20)
        try:
            cli_active = json.loads(cli.stdout).get("active")
        except ValueError:
            cli_active = None
        check("CLI-status visar samma pågående överföring", bool(cli_active) and cli_active.get("name") == "stor3.bin",
              (cli_active and "%s %d%%" % (cli_active["name"], cli_active["pct"])) or ("utdata: " + cli.stdout[:60]))
        done.wait(timeout=60)
        check("uppladdningen blev klar (200)", mid.get("status") == 200, str(mid.get("fel") or mid.get("status")))
        stor3 = os.path.join(tmp, "Received", "stor3.bin")
        check("  ... och filen är byte-identisk",
              os.path.isfile(stor3) and open(stor3, "rb").read() == payload)
        with urllib.request.urlopen("http://127.0.0.1:%d/t/%s/status" % (port, token), timeout=5) as r:
            after = json.loads(r.read()).get("active")
        check("active är tom igen efteråt", after is None, str(after))

        # Namnet på en uppladdning väljs och filen skapas i SAMMA syscall
        # (create_unique, O_EXCL). Förr frågade koden os.path.exists och öppnade
        # sedan: två samtidiga uppladdningar med samma namn valde samma sökväg och
        # skrev över varandra — mätt 12 samtidiga "samma.jpg" gav 7-10 filer på
        # disk, medan alla tolv svaren sa "saved". Tyst dataförlust.
        mottaget = os.path.join(tmp, "Received")
        burst = 12
        släpp = threading.Barrier(burst)
        namn_svar = []

        def skicka(i):
            kropp, ctype = multipart([("samma.bin", bytes([65 + i]) * 120_000)])
            req = urllib.request.Request("http://127.0.0.1:%d/t/%s/upload" % (port, token), data=kropp,
                                         headers={"Content-Type": ctype}, method="POST")
            släpp.wait()
            try:
                with urllib.request.urlopen(req, timeout=30) as r:
                    namn_svar.extend(json.loads(r.read()).get("saved", []))
            except Exception as exc:                    # noqa: BLE001 — provet rapporterar själv
                namn_svar.append("FEL: %r" % exc)

        trådar = [threading.Thread(target=skicka, args=(i,)) for i in range(burst)]
        for t in trådar:
            t.start()
        for t in trådar:
            t.join(60)
        samma = [f for f in os.listdir(mottaget) if f.startswith("samma")]
        hela = all(os.path.getsize(os.path.join(mottaget, f)) == 120_000 for f in samma)
        check("samtidiga uppladdningar med samma namn får var sitt namn",
              len(namn_svar) == burst and len(set(namn_svar)) == burst and len(samma) == burst and hela,
              "%d svar, %d unika namn, %d filer i Received" % (len(namn_svar), len(set(namn_svar)), len(samma)))
        # Mottagna filer skapades genom umask (0644) medan varje annan fil vi äger
        # är 0600. Mätt: en uppladdad fil blev 0644.
        lägen = [oct(stat.S_IMODE(os.stat(os.path.join(mottaget, f)).st_mode))[-3:] for f in samma]
        check("mottagna filer skrivs 0600, inte genom umask",
              len(samma) == burst and set(lägen) == {"600"}, str(lägen[:3]))

        # En klient som försvinner mitt i kroppen: den halva delen ska kastas, inte
        # ligga kvar i Received som om den vore hel. Mätt förut: 599 863 av
        # 2 000 139 byte låg kvar som "halv.bin", utan markering.
        kropp, ctype = multipart([("halv.bin", b"H" * 400_000)])
        skarv = socket.create_connection(("127.0.0.1", port), timeout=10)
        skarv.sendall(("POST /t/%s/upload HTTP/1.1\r\nHost: sling\r\nContent-Type: %s\r\n"
                       "Content-Length: %d\r\n\r\n" % (token, ctype, len(kropp))).encode() + kropp[:150_000])
        time.sleep(0.4)
        skarv.close()
        time.sleep(0.6)
        check("avbruten uppladdning lämnar ingen halv fil",
              not os.path.exists(os.path.join(mottaget, "halv.bin")),
              "halv.bin borta" if not os.path.exists(os.path.join(mottaget, "halv.bin"))
              else "ligger kvar med %d byte" % os.path.getsize(os.path.join(mottaget, "halv.bin")))

        # Panelen pollar /status var 1,5 s medan Alex rensar Received, och en
        # nedladdning kan ryka mitt i. En fil som försvinner mellan listningen och
        # stat-anropet fick förut förfrågan att dö utan svar — mätt 3092 av 5634
        # /status-anrop. Ett 404 är ett svar; ett tyst avbrott är det inte.
        for i in range(20):
            with open(os.path.join(mottaget, "churn%d.bin" % i), "wb") as fh:
                fh.write(b"x" * 4096)
        slut = threading.Event()

        def rör():
            while not slut.is_set():
                for i in range(20):
                    try:
                        os.remove(os.path.join(mottaget, "churn%d.bin" % i))
                        with open(os.path.join(mottaget, "churn%d.bin" % i), "wb") as fh:
                            fh.write(b"x" * 4096)
                    except OSError:
                        pass

        threading.Thread(target=rör, daemon=True).start()
        tysta, anrop = 0, 0
        t0 = time.monotonic()
        while time.monotonic() - t0 < 3:
            for väg in ("status", "download/churn3.bin"):
                anrop += 1
                try:
                    with urllib.request.urlopen("http://127.0.0.1:%d/t/%s/%s" % (port, token, väg), timeout=5) as r:
                        r.read()
                except urllib.error.HTTPError as e:
                    if e.code != 404:
                        tysta += 1
                except Exception:                       # noqa: BLE001 — räknas som tyst svar
                    tysta += 1
        slut.set()
        check("fil som försvinner mitt i listningen ger inget tyst svar", tysta == 0,
              "%d av %d anrop utan svar" % (tysta, anrop))

        pid_fil = os.path.join(tmp, "sling", "pid")
        check("pid-filen skrivs 0600", stat.S_IMODE(os.stat(pid_fil).st_mode) == 0o600,
              oct(stat.S_IMODE(os.stat(pid_fil).st_mode))[-3:])

        # En wl-copy som aldrig blir klar: /clip-anropet ska få ett svar inom taket
        # och inte lämna någon process kvar. Förut kördes wl-copy utan tak, så en
        # server-tråd per anrop låg kvar för alltid — 32 av dem tar hela
        # anslutningstaket och servern nekar alla. Skenet skriver sina egna pidar
        # till en fil, så provet pekar ut exakt de processerna (att leta i /proc
        # efter namn kan träffa någon annans kommandorad).
        häng_pidfil = os.path.join(tmp, "hang.pid")
        with open(os.path.join(shim, "wl-copy"), "w") as fh:
            fh.write("#!/bin/sh\nsleep 4317 &\necho \"$$ $!\" > '%s'\nexec sleep 4317\n" % häng_pidfil)
        os.chmod(os.path.join(shim, "wl-copy"), 0o755)
        t0 = time.monotonic()
        kod = None
        try:
            req = urllib.request.Request("http://127.0.0.1:%d/t/%s/clip" % (port, token),
                                         data=b"text som aldrig kommer fram", method="POST")
            with urllib.request.urlopen(req, timeout=30) as r:
                kod = r.status
        except urllib.error.HTTPError as e:
            kod = e.code
        except Exception as exc:                      # noqa: BLE001 — tidsgräns eller tyst avbrott
            kod = repr(exc)
        hängde = time.monotonic() - t0
        with open(os.path.join(shim, "wl-copy"), "w") as fh:
            fh.write('printf "%%s\\n" "$*" >> "%s"\ncat > "%s"\n' % (clip_argv, clip_out))
        os.chmod(os.path.join(shim, "wl-copy"), 0o755)
        check("hängande wl-copy ger svar inom taket", kod == 500 and hängde < 10,
              "%s efter %.1f s" % (kod, hängde))
        try:
            with open(häng_pidfil) as fh:
                häng_pidar = [int(p) for p in fh.read().split()]
        except (OSError, ValueError):
            häng_pidar = []
        kvar = []
        for _ in range(20):                       # hinner skördas innan domen
            kvar = [p for p in häng_pidar if lever(p)]
            if not kvar:
                break
            time.sleep(0.1)
        check("  ... och lämnar ingen process kvar", len(häng_pidar) == 2 and not kvar,
              "%d pidar, kvar: %s" % (len(häng_pidar), kvar))
        for p in kvar:                            # städa efter ett underkänt prov
            try:
                os.kill(p, signal.SIGKILL)
            except OSError:
                pass

        # Samma tak för notify-send. Notisen ligger på förfrågningsvägen både vid
        # uppladdning och vid /clip och kördes förut utan tak — mätt: ett hängande
        # notify-send lämnade uppladdningen utan svar i 20 s (klienten gav upp) och
        # två processer kvar. Notisen är kosmetisk; den får aldrig hålla förfrågan.
        notis_pidfil = os.path.join(tmp, "notis-hang.pid")
        with open(os.path.join(shim, "notify-send"), "w") as fh:
            fh.write("#!/bin/sh\nsleep 4319 &\necho \"$$ $!\" > '%s'\nexec sleep 4319\n" % notis_pidfil)
        os.chmod(os.path.join(shim, "notify-send"), 0o755)
        t0 = time.monotonic()
        notis_kod = None
        kropp, ctype = multipart([("notis.bin", b"N" * 50_000)])
        try:
            req = urllib.request.Request("http://127.0.0.1:%d/t/%s/upload" % (port, token), data=kropp,
                                         headers={"Content-Type": ctype}, method="POST")
            with urllib.request.urlopen(req, timeout=30) as r:
                notis_kod = r.status
        except Exception as exc:                      # noqa: BLE001 — provet rapporterar själv
            notis_kod = repr(exc)
        notis_hängde = time.monotonic() - t0
        with open(os.path.join(shim, "notify-send"), "w") as fh:
            fh.write('printf "%%s\\n" "$*" >> "%s"\n' % notif_log)
        os.chmod(os.path.join(shim, "notify-send"), 0o755)
        check("hängande notify-send ger svar inom taket", notis_kod == 200 and notis_hängde < 10,
              "%s efter %.1f s" % (notis_kod, notis_hängde))
        try:
            with open(notis_pidfil) as fh:
                notis_pidar = [int(p) for p in fh.read().split()]
        except (OSError, ValueError):
            notis_pidar = []
        kvar_notis = []
        for _ in range(20):
            kvar_notis = [p for p in notis_pidar if lever(p)]
            if not kvar_notis:
                break
            time.sleep(0.1)
        check("  ... och lämnar ingen process kvar", len(notis_pidar) == 2 and not kvar_notis,
              "%d pidar, kvar: %s" % (len(notis_pidar), kvar_notis))
        for p in kvar_notis:
            try:
                os.kill(p, signal.SIGKILL)
            except OSError:
                pass

        # `copy` (URL:en till urklippet) var det sista subprocess-anropet utan tak
        # kvar i filen: ett hängande wl-copy lämnade kommandot utan återkomst och två
        # processer kvar — samma klass som /clip och notisen, ett kommando längre bort.
        # PATH riktas om till skalet under anropet (först i PATH, resten kvar så att
        # `sleep` inne i skalet finns), så provet varken rör Alex urklipp eller nätet,
        # och anropet körs i en tråd: en kvarhängande körning ska synas som ett
        # underkänt prov, inte hänga hela selftesten.
        copy_pidfil = os.path.join(tmp, "copy-hang.pid")
        with open(os.path.join(shim, "wl-copy"), "w") as fh:
            fh.write("#!/bin/sh\nsleep 4323 &\necho \"$$ $!\" > '%s'\nexec sleep 4323\n" % copy_pidfil)
        os.chmod(os.path.join(shim, "wl-copy"), 0o755)
        sparat_token = globals()["_TOKEN"]
        sparat_path = os.environ.get("PATH", "")
        globals()["_TOKEN"] = "provtoken"
        os.environ["PATH"] = shim + (":" + sparat_path if sparat_path else "")
        kort = {}

        def kor_copy():
            try:
                kort["kod"] = cmd_copy()
            except Exception as exc:                   # noqa: BLE001 — provet rapporterar själv
                kort["kod"] = repr(exc)

        t0 = time.monotonic()
        ctråd = threading.Thread(target=kor_copy, daemon=True)
        ctråd.start()
        ctråd.join(15)
        copy_tid = time.monotonic() - t0
        hängde_kvar = ctråd.is_alive()
        os.environ["PATH"] = sparat_path
        globals()["_TOKEN"] = sparat_token
        with open(os.path.join(shim, "wl-copy"), "w") as fh:
            fh.write('printf "%%s\\n" "$*" >> "%s"\ncat > "%s"\n' % (clip_argv, clip_out))
        os.chmod(os.path.join(shim, "wl-copy"), 0o755)
        try:
            with open(copy_pidfil) as fh:
                copy_pidar = [int(p) for p in fh.read().split()]
        except (OSError, ValueError):
            copy_pidar = []
        kvar_copy = []
        for _ in range(20):
            kvar_copy = [p for p in copy_pidar if lever(p)]
            if not kvar_copy:
                break
            time.sleep(0.1)
        check("hängande wl-copy i `copy` ger återkomst inom taket",
              not hängde_kvar and kort.get("kod") == 0 and copy_tid < 10,
              "%s efter %.1f s%s" % (kort.get("kod"), copy_tid, " (hängde kvar)" if hängde_kvar else ""))
        check("  ... och lämnar ingen process kvar", len(copy_pidar) == 2 and not kvar_copy,
              "%d pidar, kvar: %s" % (len(copy_pidar), kvar_copy))
        for p in kvar_copy:
            try:
                os.kill(p, signal.SIGKILL)
            except OSError:
                pass
    finally:
        proc.terminate()
        try:
            proc.wait(timeout=10)
        except subprocess.TimeoutExpired:
            proc.kill()
        # Vid avväpning städas token, pid, URL och QR. URL-filen och QR-bilden bär
        # samma token som tokenfilen; förut städades bara två av fyra, så en kopia
        # av token låg kvar i tillståndskatalogen.
        kvar_i_tillstand = sorted(os.listdir(os.path.join(tmp, "sling")))
        check("avväpningen städar token, pid, URL och QR",
              not [n for n in kvar_i_tillstand if n.startswith(("token", "pid", "url", "qr"))],
              str(kvar_i_tillstand))

        # Start och stopp, i egen port och egen katalog (selftestens egen server är
        # redan nere, så inget här kan röra den). Två samtidiga `start` — som ett
        # dubbelklick i panelen — skrev förut båda sin token och den som förlorade
        # porten dog på "Address already in use": kvar stod panelens URL och QR med
        # en token som den körande servern nekar (mätt: HTTP 403), och förlorarens
        # städning kunde radera den körandes filer.
        sub = os.path.join(tmp, "sub")
        os.makedirs(os.path.join(sub, "run"), exist_ok=True)
        sub_port = port + 1
        sub_state = os.path.join(sub, "run", "sling")
        sub_env = dict(env, SLING_PORT=str(sub_port), SLING_BASE_DIR=sub,
                       XDG_RUNTIME_DIR=os.path.join(sub, "run"), XDG_STATE_HOME=sub)
        starter = []

        def starta():
            starter.append(subprocess.run([sys.executable, os.path.abspath(__file__), "start"],
                                          env=sub_env, capture_output=True, text=True, timeout=60))

        trådar = [threading.Thread(target=starta) for _ in range(2)]
        for t in trådar:
            t.start()
        for t in trådar:
            t.join(60)
        try:
            with open(os.path.join(sub_state, "token")) as fh:
                sub_token = fh.read().strip()
        except OSError:
            sub_token = ""
        sub_svar = None
        if sub_token:
            try:
                with urllib.request.urlopen("http://127.0.0.1:%d/t/%s/status" % (sub_port, sub_token), timeout=5) as r:
                    sub_svar = r.status
            except Exception:                     # noqa: BLE001 — räknas som "svarar inte"
                sub_svar = None
        sub_filer = sorted(os.listdir(sub_state)) if os.path.isdir(sub_state) else []
        check("två samtidiga start lämnar en token som den körande servern tar",
              sub_svar == 200 and all(f in sub_filer for f in ("token", "pid", "url", "qr.png")),
              "status=%s, filer=%s" % (sub_svar, sub_filer))

        # Stopp: fallbacken fick förut döda vilken process som helst vars kommandorad
        # nämnde "omarchy-sling server" (mätt: ett skal med texten i en kommentar).
        # Provet prövar urvalet, inte signalen, så inget annat än selftestens egen
        # sub-server kan komma i fråga.
        # Skenet får ett eget tak (timeout 60): en krasch i ett prov lämnade en sådan
        # process kvar på maskinen (mätt), och ett prov får inte lämna spår.
        oskyldig = subprocess.Popen(["timeout", "60", "bash", "-c",
                                     "while :; do sleep 1; done  # omarchy-sling server"])
        time.sleep(0.4)
        try:
            with open(os.path.join(sub_state, "pid")) as fh:
                sub_pid = int(fh.read().strip())
        except (OSError, ValueError):
            sub_pid = 0
        egna = server_pids()
        check("vår egen server pekas ut för stopp", sub_pid in egna, "%s i %s" % (sub_pid, egna))
        check("främmande process med vår sträng i kommandoraden pekas inte ut",
              oskyldig.pid not in egna, "oskyldig %d, egna %s" % (oskyldig.pid, egna))

        # HANCORE, ärende 10821: matchen såg namnen var som helst i argv, så
        # `rg server omarchy-sling` — eller en editor öppnad på de två filerna —
        # pekades ut som vår server och hade dödats av `stop` (mätt: en främmande
        # process med ["server", "omarchy-sling"] i argv). Nu måste argv[1] vara
        # samma fil som den här processen kör och argv[2] vara "server".
        namnbärare = subprocess.Popen([sys.executable, "-c", "import time; time.sleep(300)",
                                       "server", "omarchy-sling"])
        time.sleep(0.4)
        check("främmande process med våra namn i argv pekas inte ut som server",
              not pid_is_our_server(namnbärare.pid) and namnbärare.pid not in server_pids(),
              "pid %d" % namnbärare.pid)

        # Fallbacken i `stop` var gatad på att PORTEN var öppen, inte på att lyssnaren
        # var vår: med en främmande lyssnare på porten dödades ändå en process vars
        # kommandorad råkade nämna våra namn (mätt). Nu krävs ett svar med vår token.
        främmande_port = sub_port + 10
        främmande = socket.socket()
        främmande.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        främmande.bind(("127.0.0.1", främmande_port))
        främmande.listen(1)
        sparade_stopp = (globals()["PORT"], globals()["PID_FILE"], globals()["TOKEN_FILE"], globals()["_TOKEN"])
        globals()["PORT"] = främmande_port
        globals()["PID_FILE"] = os.path.join(tmp, "ingen-pid-fil")
        globals()["TOKEN_FILE"] = os.path.join(sub_state, "token")
        globals()["_TOKEN"] = ""
        try:
            cmd_stop()
        finally:
            globals()["PORT"], globals()["PID_FILE"] = sparade_stopp[0], sparade_stopp[1]
            globals()["TOKEN_FILE"], globals()["_TOKEN"] = sparade_stopp[2], sparade_stopp[3]
            främmande.close()
        time.sleep(0.3)
        check("stop rör inget när porten hålls av någon annan",
              namnbärare.poll() is None and sub_pid in server_pids(),
              "namnbärare %s, sub-server %s" % (namnbärare.poll(), lever(sub_pid)))
        namnbärare.kill()

        # och stoppet stänger sub-servern (pid-vägen, som är den vanliga)
        stopp = subprocess.run([sys.executable, os.path.abspath(__file__), "stop"], env=sub_env,
                               capture_output=True, text=True, timeout=60)
        time.sleep(0.6)
        sub_nere = True
        try:
            with urllib.request.urlopen("http://127.0.0.1:%d/t/%s/status" % (sub_port, sub_token), timeout=3) as r:
                sub_nere = False
        except Exception:                         # noqa: BLE001 — nere är det väntade
            pass
        check("stop stänger sub-servern", sub_nere and "stopped" in (stopp.stdout + stopp.stderr).lower(),
              (stopp.stdout + stopp.stderr).strip()[:40])
        check("  ... och den oskyldiga processen lever fortfarande", lever(oskyldig.pid),
              "oskyldig %d" % oskyldig.pid)
        oskyldig.kill()

        # Avväpningstimern räknade bara förfrågningar, inte pågående överföring: en
        # transfer som tar längre tid än SLING_IDLE_TIMEOUT kapades mitt i (mätt med
        # taket satt till 2 s: BrokenPipe efter 3,6 s och ingen fil på disk). Panelen
        # håller timern levande med sin poll, men en server startad som
        # `omarchy-sling start` i en terminal har ingen poll. Nu räknas varje läst bit.
        långsam = os.path.join(tmp, "langsam")
        os.makedirs(os.path.join(långsam, "run"), exist_ok=True)
        långsam_port = port + 2
        långsam_state = os.path.join(långsam, "run", "sling")
        långsam_env = dict(env, SLING_PORT=str(långsam_port), SLING_BASE_DIR=långsam,
                           XDG_RUNTIME_DIR=os.path.join(långsam, "run"), XDG_STATE_HOME=långsam,
                           SLING_IDLE_TIMEOUT="2")
        långsam_srv = subprocess.Popen([sys.executable, os.path.abspath(__file__), "server"],
                                       env=långsam_env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        try:
            långsam_token = ""
            for _ in range(80):
                try:
                    with open(os.path.join(långsam_state, "token")) as fh:
                        långsam_token = fh.read().strip()
                except OSError:
                    långsam_token = ""
                if långsam_token:
                    break
                time.sleep(0.05)
            gräns = "----langsam"
            huvud = ("--%s\r\nContent-Disposition: form-data; name=\"files\"; filename=\"langsam.bin\"\r\n"
                     "Content-Type: application/octet-stream\r\n\r\n" % gräns).encode()
            slut = ("\r\n--%s--\r\n" % gräns).encode()
            bit = b"L" * (32 * 1024)
            antal = 8
            längd = len(huvud) + antal * len(bit) + len(slut)
            skarv = socket.create_connection(("127.0.0.1", långsam_port), timeout=10)
            skarv.sendall(("POST /t/%s/upload HTTP/1.1\r\nHost: sling\r\nContent-Type: multipart/form-data; "
                           "boundary=%s\r\nContent-Length: %d\r\n\r\n"
                           % (långsam_token, gräns, längd)).encode() + huvud)
            t0 = time.monotonic()
            överföringsfel = None
            långsam_svar = b""
            try:
                for _ in range(antal):
                    skarv.sendall(bit)
                    time.sleep(0.5)                # ~4 s, längre än taket på 2 s
                skarv.sendall(slut)
                skarv.settimeout(10)
                långsam_svar = skarv.recv(40)
            except Exception as exc:               # noqa: BLE001 — avbrottet är fyndet
                överföringsfel = repr(exc)
            tid = time.monotonic() - t0
            skarv.close()
            långsam_fil = os.path.join(långsam, "Received", "langsam.bin")
            check("avväpningstimern ser en pågående överföring",
                  överföringsfel is None and b"200" in långsam_svar and os.path.exists(långsam_fil)
                  and os.path.getsize(långsam_fil) == antal * len(bit),
                  "%s efter %.1f s, fil: %s" % (överföringsfel or långsam_svar[:16], tid,
                                                os.path.getsize(långsam_fil) if os.path.exists(långsam_fil) else "saknas"))

            # Vakt, inte ett nytt fynd: den skärpta grinden får inte göra `stop`
            # tandlös. Med pid-filen oduglig ska token-handskakningen ändå stänga vår
            # server (grön både före och efter ändringen — det är hela poängen: att
            # stoppa för lite vore ett fel det också).
            sparade_stopp = (globals()["PORT"], globals()["PID_FILE"],
                             globals()["TOKEN_FILE"], globals()["_TOKEN"])
            globals()["PORT"] = långsam_port
            globals()["PID_FILE"] = os.path.join(tmp, "ingen-pid-fil-alls")
            globals()["TOKEN_FILE"] = os.path.join(långsam_state, "token")
            globals()["_TOKEN"] = ""
            try:
                cmd_stop()
            finally:
                globals()["PORT"], globals()["PID_FILE"] = sparade_stopp[0], sparade_stopp[1]
                globals()["TOKEN_FILE"], globals()["_TOKEN"] = sparade_stopp[2], sparade_stopp[3]
            time.sleep(0.6)
            långsam_nere = True
            try:
                with urllib.request.urlopen("http://127.0.0.1:%d/t/%s/status" % (långsam_port, långsam_token),
                                            timeout=3) as r:
                    långsam_nere = False
            except Exception:                      # noqa: BLE001 — nere är det väntade
                pass
            check("stop hittar servern via token när pid-filen inte duger", långsam_nere,
                  "svarade fortfarande" if not långsam_nere else "nere")
        finally:
            långsam_srv.terminate()
            try:
                långsam_srv.wait(timeout=10)
            except subprocess.TimeoutExpired:
                långsam_srv.kill()
        shutil.rmtree(tmp, ignore_errors=True)

    print("\n%d kontroller, %d misslyckade" % (counted["n"], len(failures)))
    if failures:
        print("MISSLYCKADE: " + ", ".join(failures))
        return 1
    print("Sling selftest: OK")
    return 0


def main():
    action = sys.argv[1] if len(sys.argv) > 1 else "status"
    if action == "server":
        sys.exit(cmd_server() or 0)
    elif action == "start":
        sys.exit(cmd_start())
    elif action == "stop":
        sys.exit(cmd_stop())
    elif action == "status":
        sys.exit(cmd_status())
    elif action == "open":
        sys.exit(cmd_open(sys.argv[2] if len(sys.argv) > 2 else None))
    elif action == "send":
        sys.exit(cmd_send(sys.argv[2:]))
    elif action == "remove":
        sys.exit(cmd_remove(sys.argv[2:]))
    elif action == "clear":
        sys.exit(cmd_clear())
    elif action == "copy":
        sys.exit(cmd_copy(sys.argv[2] if len(sys.argv) > 2 else None))
    elif action == "clip":
        sys.exit(cmd_clip())
    elif action == "send-pick":
        sys.exit(cmd_send_pick())
    elif action == "selftest":
        sys.exit(cmd_selftest())
    else:
        print("Usage: omarchy-sling [server | start | stop | status | open [send] | send <fil...> | "
              "remove <fil...> | clear | clip | send-pick | copy [mdns] | selftest]")
        sys.exit(2)


if __name__ == "__main__":
    main()

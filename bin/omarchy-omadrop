#!/usr/bin/env python3
# ==============================================================================
# OmaDrop (Omarchy File Drop Daemon & CLI)
# Part of OmaDrop - https://github.com/alexwest1981/OmaDrop
#
# Säkerhetsmodell: servern lyssnar på LAN:et, men varje förfrågan måste bära en
# token i sökvägen (/t/<token>/...). Token skapas vid start, byts varje gång och
# följer med i QR-koden. Servern avväpnar sig själv efter OMADROP_IDLE_TIMEOUT
# sekunder utan trafik.
# ==============================================================================

import html
import json
import os
import re
import secrets
import shutil
import signal
import socket
import subprocess
import sys
import threading
import time
import urllib.parse
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

VERSION = "1.1.0"
PORT = int(os.environ.get("OMADROP_PORT", 5380))
IDLE_TIMEOUT = int(os.environ.get("OMADROP_IDLE_TIMEOUT", 900))
MAX_UPLOAD = int(os.environ.get("OMADROP_MAX_UPLOAD", 2 * 1024**3))
MDNS_NAME = os.environ.get("OMADROP_MDNS_NAME", "omadrop")

BASE_DIR = os.path.expanduser(os.environ.get("OMADROP_BASE_DIR", "~/Downloads/OmaDrop"))
RECEIVED_DIR = os.path.join(BASE_DIR, "Received")
SEND_DIR = os.path.join(BASE_DIR, "Send")

STATE_DIR = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "omadrop")
QR_PATH = os.path.join(STATE_DIR, "qr.png")
URL_FILE = os.path.join(STATE_DIR, "url")
PID_FILE = os.path.join(STATE_DIR, "pid")
TOKEN_FILE = os.path.join(STATE_DIR, "token")
LOG_DIR = os.path.join(os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")), "omadrop")
LOG_PATH = os.path.join(LOG_DIR, "server.log")

for _d in (RECEIVED_DIR, SEND_DIR, STATE_DIR, LOG_DIR):
    os.makedirs(_d, exist_ok=True)

LAST_ACTIVITY = {"t": time.monotonic()}
_TOKEN = ""

# ------------------------------------------------------------------------------
# Notiser i18n (datorns språk)
# ------------------------------------------------------------------------------
NOTIF_STRINGS = {
    "en": {"received_single": "📥 OmaDrop: 1 new file received", "received_multi": "📥 OmaDrop: {count} new files received"},
